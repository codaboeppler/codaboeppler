---
/* Standalone shell for the "Landing ataskate" page.
   It deliberately does NOT pull in global.css / the theme toggle: the design
   is a fixed light palette taken straight from the ataskate design-system
   colour tokens, so the dark-theme semantics would fight it. */
import { siteConfig } from '../data/site';
import Clarity from '../components/Clarity.astro';
import Zendesk from '../components/Zendesk.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title = 'ataskate — Software prendario para casas de empeño',
  description =
    'Contratos, inventario, crédito y venta en una sola plataforma hecha para casas de empeño. Sin papel, sin Excel, sin pretextos.',
  canonicalPath = '/landing/',
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? siteConfig.url).toString();
const ogImage = new URL(siteConfig.ogImage, siteConfig.url).toString();
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand/ataskate-mark.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#d5a4ff" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />

    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content={siteConfig.locale} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteConfig.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&family=Platypi:wght@600;700&display=swap"
      rel="stylesheet"
    />

    <Clarity />
    <Zendesk />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Saltar al contenido</a>
    <slot />
  </body>
</html>

<style is:global>
  /* ---------- tokens (ataskate design system · colours.css) ---------- */
  :root {
    --navy: #0d166b;
    --indigo: #5a5aff;
    --indigo-press: #4747e0;

    --purple-10: #fafaff;
    --purple-50: #f0f0ff;
    --purple-100: #e5e5ff;
    --purple-200: #acacff;

    --lila-200: #d5a4ff;
    --pink-100: #ff98ef;
    --pink-200: #ff6ae8;
    --lemon-200: #d8ff03;

    --ink: #09001c;
    --body: #2a2c2f;
    --caption: #54575c;
    --placeholder: #a1a5aa;
    --line: #d4d6d8;
    --line-soft: #e8e9ea;
    --empty: #eff0f0;
    --page: #fbfbfe;

    --ok-surface: #effaf4;
    --ok-icon: #309c60;
    --ok-title: #174a2e;
    --warn-surface: #ffebba;
    --warn-icon: #cc9200;

    --shadow-card: 0 1px 2px rgba(13, 22, 107, 0.05), 0 24px 48px -26px rgba(13, 22, 107, 0.16);
    --shadow-float: 0 8px 32px rgba(13, 22, 107, 0.16);

    --font-sans: 'Nunito', -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-display: 'Platypi', Georgia, 'Times New Roman', serif;

    /* type scale — display (Platypi) steps + text steps used across the pages */
    --fs-d1: clamp(34px, 4vw, 56px);
    --lh-d1: 1.1;
    --fs-d2: clamp(30px, 3.5vw, 48px);
    --lh-d2: 1.12;
    --fs-d3: clamp(26px, 3vw, 38px);
    --lh-d3: 1.16;
    --fs-d4: 26px;
    --ls-display: -0.015em;
    --fs-lede: 20px;
    --fs-title: 18px;
    --fs-body: 16px;
    --fs-small: 14px;
    --fs-micro: 12px;
    --measure: 60ch;
  }

  /* ---------- reset ---------- */
  *,
  *::before,
  *::after { box-sizing: border-box; }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 92px;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--page);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 16px;
    line-height: 1.5;
    letter-spacing: 0.3px;
    overflow-x: clip;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  img, svg, video { display: block; max-width: 100%; }
  h1, h2, h3, p, figure { margin: 0; }
  h1, h2, h3 { letter-spacing: 0; }
  ul { margin: 0; padding: 0; list-style: none; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  input { font: inherit; color: inherit; }

  :focus-visible {
    outline: 3px solid var(--indigo);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .skip {
    position: absolute;
    left: -9999px;
    top: 8px;
    z-index: 100;
    padding: 10px 18px;
    border-radius: 100px;
    background: var(--navy);
    color: #fff;
    font-weight: 700;
  }
  .skip:focus { left: 16px; }

  ::selection { background: var(--lemon-200); color: var(--ink); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: 0.001ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.001ms !important;
    }
  }
</style>
