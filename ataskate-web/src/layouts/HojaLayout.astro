---
import { siteConfig } from '../data/site';
import Clarity from '../components/Clarity.astro';
import Zendesk from '../components/Zendesk.astro';
import '../styles/global.css';

interface Props { title?: string; description?: string; nav?: { href: string; label: string }[]; canonicalPath?: string; }
const {
  title = 'ataskate — La hoja de operación · POS para casas de empeño',
  description = siteConfig.description,
  canonicalPath = '/v2',
  nav = [
    { href: '#modulos', label: 'Módulos' },
    { href: '#flujo', label: 'Flujo' },
    { href: '#reportes', label: 'Reportes' },
    { href: '#porque', label: 'Por qué' },
  ],
} = Astro.props;

const canonical = new URL(canonicalPath, Astro.site ?? siteConfig.url).toString();
---
<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/brand/ataskate-mark.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('/brand/og.svg', siteConfig.url).toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800;900&family=Nunito+Sans:wght@500;600&family=Platypi:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('ats-theme');
          // Default to LIGHT for everyone; only go dark if the visitor explicitly chose it.
          const dark = stored === 'dark';
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch (e) { document.documentElement.dataset.theme = 'light'; }
      })();
    </script>
    <Clarity />
    <Zendesk />
  </head>
  <body id="inicio" class="hoja">
    <a href="#main" class="skip-link">Saltar al contenido</a>

    <!-- ============================== HEADER (slot-overridable) ============================== -->
    <slot name="header">
    <header class="mast">
      <div class="container--lg mast__inner">
        <a href="#inicio" class="mast__brand" aria-label="ataskate — inicio">
          <span class="mast__mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
              <rect x="0.5" y="0.5" width="31" height="31" rx="9" fill="currentColor"/>
              <path d="M9 23.5 L15.1 9.2 C15.45 8.4 16.55 8.4 16.9 9.2 L23 23.5" stroke="var(--bg)" stroke-width="3.1" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M11.7 18.4 H20.3" stroke="var(--bg)" stroke-width="3.1" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="mast__name">ataskate</span>
        </a>
        <nav class="mast__nav" aria-label="Principal">
          {nav.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <div class="mast__actions">
          <button data-theme-toggle class="mast__theme" aria-label="Cambiar tema" type="button">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          </button>
          <a href="#demo" class="btn btn--sm btn--primary mast__cta">Solicitar demo
            <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        </div>
      </div>
    </header>
    </slot>

    <main id="main"><slot /></main>

    <!-- ============================== COLOPHON FOOTER ============================== -->
    <footer class="colo">
      <div class="container--lg colo__inner">
        <div class="colo__brand">
          <a href="#inicio" class="colo__logo" aria-label="ataskate — inicio">
            <span class="colo__mark" aria-hidden="true">
              <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="0.5" y="0.5" width="31" height="31" rx="9" fill="currentColor"/>
                <path d="M9 23.5 L15.1 9.2 C15.45 8.4 16.55 8.4 16.9 9.2 L23 23.5" stroke="var(--bg)" stroke-width="3.1" stroke-linecap="round" stroke-linejoin="round"/>
                <path d="M11.7 18.4 H20.3" stroke="var(--bg)" stroke-width="3.1" stroke-linecap="round"/>
              </svg>
            </span>
            <span class="colo__name">ataskate</span>
          </a>
          <p class="colo__tag">{siteConfig.tagline}</p>
        </div>
        <div class="colo__meta">
          <div>
            <span class="colo__lbl mono">CONTACTO</span>
            <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
            <span class="mono colo__muted">{siteConfig.contact.phone}</span>
          </div>
          <div>
            <span class="colo__lbl mono">OPERACIÓN</span>
            <a href="#modulos">Módulos</a>
            <a href="#flujo">Flujo del mostrador</a>
            <a href="#reportes">Reportes</a>
          </div>
          <div>
            <span class="colo__lbl mono">CASA</span>
            <span class="colo__muted">Ciudad de México</span>
            <a href="#demo">Solicitar demo</a>
          </div>
        </div>
      </div>
      <div class="container--lg colo__bar">
        <span class="mono">© 2026 ataskate</span>
        <span class="mono colo__muted">Hecho para el mostrador · es-MX</span>
      </div>
    </footer>

    <style is:global>
      /* v2 reveal: the HojaLayout script adds .is-in (instead of inline styles).
         Base hidden state for [data-reveal] comes from motion.css. */
      [data-reveal].is-in { opacity: 1 !important; transform: none !important; }
      .is-paused { animation-play-state: paused !important; }
      /* Anti-glow: this page replaces the neon button glow with a tinted diffusion shadow. */
      .hoja .btn--primary:hover { box-shadow: var(--shadow-2); }
    </style>

    <style>
      /* ===== editorial header ===== */
      .mast {
        position: sticky; top: 0; z-index: var(--z-sticky);
        background: color-mix(in srgb, var(--bg) 86%, transparent);
        backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
        border-bottom: 1px solid var(--border);
      }
      .mast__inner { display: flex; align-items: center; gap: var(--s-5); height: 68px; }
      .mast__brand { display: inline-flex; align-items: center; gap: 10px; color: var(--text-strong); }
      .mast__mark { display: inline-flex; width: 28px; height: 28px; color: var(--brand); transition: transform var(--d-slow) var(--ease); }
      .mast__mark svg { width: 100%; height: 100%; }
      .mast__brand:hover .mast__mark { transform: rotate(-6deg); }
      .mast__name { font: 900 20px/1 var(--font-sans); letter-spacing: -0.04em; }
      .mast__nav { display: none; margin-left: var(--s-6); gap: var(--s-2); }
      @media (min-width: 860px) { .mast__nav { display: inline-flex; } }
      .mast__nav a {
        font: 700 12px/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em;
        color: var(--text-tertiary, var(--text-muted)); padding: 8px 6px; position: relative;
        transition: color var(--d-fast) var(--ease);
      }
      .mast__nav a::after { content: ''; position: absolute; left: 6px; right: 6px; bottom: 2px; height: 1.5px; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform var(--d-fast) var(--ease); }
      .mast__nav a:hover { color: var(--text-strong); }
      .mast__nav a:hover::after { transform: scaleX(1); }
      .mast__actions { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; }
      .mast__theme { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; border-radius: 50%; color: var(--text-muted); transition: background var(--d-fast) var(--ease), color var(--d-fast) var(--ease); }
      .mast__theme:hover { background: var(--bg-soft); color: var(--text-strong); }
      @media (max-width: 420px) { .mast__name { display: none; } }

      /* ===== colophon footer ===== */
      .colo { margin-top: var(--s-12); border-top: 1px solid var(--border); background: var(--bg); }
      .colo__inner { display: grid; grid-template-columns: 1fr; gap: var(--s-8); padding: clamp(56px, 7vw, 96px) 0 var(--s-7); }
      @media (min-width: 820px) { .colo__inner { grid-template-columns: 1.1fr 1.6fr; gap: var(--s-10); } }
      .colo__logo { display: inline-flex; align-items: center; gap: 10px; color: var(--text-strong); }
      .colo__mark { display: inline-flex; width: 28px; height: 28px; color: var(--brand); }
      .colo__name { font: 900 20px/1 var(--font-sans); letter-spacing: -0.04em; }
      .colo__tag { margin-top: var(--s-4); font-family: var(--font-display); font-weight: 900; font-size: clamp(22px, 2.4vw, 32px); line-height: 1.05; letter-spacing: -0.03em; color: var(--text-strong); max-width: 18ch; }
      .colo__meta { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-6); }
      @media (max-width: 540px) { .colo__meta { grid-template-columns: 1fr 1fr; } }
      .colo__meta > div { display: flex; flex-direction: column; gap: 10px; }
      .colo__lbl { font-size: 11px; letter-spacing: 0.14em; color: var(--text-subtle); }
      .colo__meta a { color: var(--text); font: 700 15px/1.2 var(--font-sans); transition: color var(--d-fast) var(--ease); }
      .colo__meta a:hover { color: var(--brand); }
      .colo__muted { color: var(--text-muted); font-size: 14px; }
      .colo__bar { display: flex; justify-content: space-between; gap: var(--s-3); padding: var(--s-5) 0; border-top: 1px solid var(--border-soft); font-size: 12px; color: var(--text-subtle); flex-wrap: wrap; }
    </style>

    <script>
      // ---------- Theme toggle ----------
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('ats-theme', next); } catch (e) {}
      });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ---------- Reveal + hairline-rule draw (one-shot IntersectionObserver) ----------
      const revealEls = Array.from(document.querySelectorAll('[data-reveal], [data-rule]'));
      revealEls.forEach((el) => {
        const p = el.parentElement;
        if (p && p.hasAttribute('data-stagger') && !el.style.getPropertyValue('--reveal-delay')) {
          const i = Array.from(p.children).indexOf(el);
          el.style.setProperty('--reveal-delay', `${i * 80}ms`);
        }
      });
      const show = (el) => el.classList.add('is-in');
      if (reduce) {
        revealEls.forEach(show);
      } else {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { show(e.target); io.unobserve(e.target); }
        }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
        revealEls.forEach((el) => {
          if (el.getBoundingClientRect().top < window.innerHeight) show(el);
          else io.observe(el);
        });
      }

      // ---------- In-view gating for perpetual loops (pause off-screen) ----------
      if (!reduce && 'IntersectionObserver' in window) {
        const gate = new IntersectionObserver((entries) => {
          for (const e of entries) e.target.classList.toggle('is-paused', !e.isIntersecting);
        }, { threshold: 0 });
        document.querySelectorAll('[data-inview]').forEach((el) => gate.observe(el));
      }

      // ---------- Flat count-up (NO gradient class) ----------
      if (!reduce) {
        const run = (el) => {
          if (el.dataset.done === '1') return; el.dataset.done = '1';
          const target = parseFloat(el.dataset.count || '0');
          const dec = (el.dataset.count || '').includes('.') ? 1 : 0;
          const pre = el.dataset.prefix || '', suf = el.dataset.suffix || '';
          const dur = parseInt(el.dataset.duration || '1300', 10);
          const fmt = (v) => pre + v.toLocaleString('es-MX', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suf;
          const t0 = performance.now();
          const tick = (now) => {
            const t = Math.min(1, (now - t0) / dur);
            el.textContent = fmt(target * (1 - Math.pow(1 - t, 3)));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };
        const co = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { run(e.target); co.unobserve(e.target); }
        }, { threshold: 0.5 });
        document.querySelectorAll('[data-count]').forEach((el) => co.observe(el));
      }

      // ---------- Signature beat: reconciliation bar completes → CUADRÓ stamp ----------
      (() => {
        const recon = document.querySelector('[data-recon]');
        if (!recon) return;
        const complete = () => recon.classList.add('is-complete');
        if (reduce) { complete(); return; }
        let fired = false;
        const go = () => { if (fired) return; fired = true; complete(); window.removeEventListener('scroll', go); };
        // resolve on first scroll, or after the loop has run a couple times
        window.addEventListener('scroll', go, { passive: true, once: true });
        setTimeout(go, 4200);
      })();

      // ---------- Demo form: validation + loading/success states (no backend) ----------
      (() => {
        const form = document.querySelector('[data-demo-form]');
        if (!form) return;
        const email = form.querySelector('input[type="email"]');
        const field = email?.closest('.fld');
        const btn = form.querySelector('[data-submit]');
        form.addEventListener('submit', (ev) => {
          ev.preventDefault();
          const ok = email && /.+@.+\..+/.test(email.value.trim());
          field?.classList.toggle('fld--error', !ok);
          if (!ok) { email?.focus(); return; }
          btn.classList.add('is-loading'); btn.disabled = true;
          const label = btn.querySelector('[data-label]');
          if (label) label.textContent = 'Enviando…';
          setTimeout(() => {
            btn.classList.remove('is-loading'); btn.classList.add('is-done');
            if (label) label.textContent = 'Solicitud enviada ✓';
          }, 1600);
        });
        email?.addEventListener('input', () => field?.classList.remove('fld--error'));
      })();
    </script>
  </body>
</html>
