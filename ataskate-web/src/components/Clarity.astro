---
/* Microsoft Clarity (grabación de sesiones y mapas de calor). El id vive en
   siteConfig.clarityId. Solo se incluye en el build de producción para no
   mezclar las visitas del entorno local con las reales. */
import { siteConfig } from '../data/site';
const id = siteConfig.clarityId;
---
{import.meta.env.PROD && id && (
  <script is:inline define:vars={{ id }}>
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', id);
  </script>
)}
