---
/* Acceso directo al WhatsApp Business de ventas: un clic abre el chat con un mensaje ya escrito.
   · en="mast"      icono del navbar; su forma vive en styles/mast.css, junto al resto de la barra
   · en="foot"      enlace con icono para los footers; toma la tipografía de los enlaces del footer de cada página
   · en="flotante"  botón fijo en la esquina inferior derecha; lo ponen los layouts, así sale en todas las páginas
   El número y el mensaje están en data/contacto.ts. El icono es "Whatsapp" del design system.
   Cada clic se cuenta en Clarity como `whatsapp_click`, con la etiqueta `whatsapp_origen`. */
import { contacto, WHATSAPP } from '../data/contacto';

interface Props {
  en: 'mast' | 'foot' | 'flotante';
  class?: string;
}
/* `resto` trae el atributo de alcance de la página que lo usa: así sus estilos (.foot__col a, .foot__bar a) le aplican */
const { en, class: clase, ...resto } = Astro.props;
const lado = { mast: 22, foot: 18, flotante: 30 }[en];
const soloIcono = en !== 'foot';
---
<a
  class:list={['wa', `wa--${en}`, en === 'mast' && 'mast__wa', clase]}
  data-wa={en}
  href={WHATSAPP}
  target="_blank"
  rel="noopener"
  aria-label={soloIcono ? 'Escríbenos por WhatsApp (se abre en otra pestaña)' : undefined}
  title={soloIcono ? 'Escríbenos por WhatsApp' : undefined}
  {...resto}
><svg viewBox="0 0 24 24" width={lado} height={lado} fill="currentColor" aria-hidden="true"><path d="M2 22L3.41254 16.8642C2.5409 15.3608 2.08289 13.6567 2.08373 11.9092C2.08624 6.44583 6.55329 2 12.0419 2C14.7053 2.00083 17.2056 3.03333 19.0862 4.90667C20.9659 6.78 22.0008 9.27 22 11.9183C21.9975 17.3825 17.5304 21.8283 12.0419 21.8283C10.3756 21.8275 8.73365 21.4117 7.27924 20.6217L2 22ZM7.52374 18.8275C8.92707 19.6567 10.2668 20.1533 12.0385 20.1542C16.6002 20.1542 20.3162 16.4592 20.3187 11.9167C20.3204 7.365 16.622 3.675 12.0452 3.67333C7.4802 3.67333 3.76673 7.36833 3.76505 11.91C3.76421 13.7642 4.31014 15.1525 5.22699 16.605L4.39052 19.645L7.52374 18.8275ZM17.0582 14.2742C16.9962 14.1708 16.8304 14.1092 16.5809 13.985C16.3322 13.8608 15.1089 13.2617 14.8803 13.1792C14.6526 13.0967 14.4868 13.055 14.3202 13.3033C14.1544 13.5508 13.6771 14.1092 13.5323 14.2742C13.3874 14.4392 13.2417 14.46 12.993 14.3358C12.7444 14.2117 11.9422 13.9508 10.9919 13.1067C10.2525 12.45 9.75266 11.6392 9.6078 11.3908C9.46295 11.1433 9.59273 11.0092 9.71665 10.8858C9.82885 10.775 9.96533 10.5967 10.0901 10.4517C10.2165 10.3083 10.2576 10.205 10.3413 10.0392C10.4242 9.87417 10.3832 9.72917 10.3204 9.605C10.2576 9.48167 9.76019 8.2625 9.55338 7.76667C9.35075 7.28417 9.14561 7.34917 8.99322 7.34167L8.51595 7.33333C8.35016 7.33333 8.08055 7.395 7.8528 7.64333C7.62505 7.89167 6.982 8.49 6.982 9.70917C6.982 10.9283 7.87373 12.1058 7.99765 12.2708C8.12241 12.4358 9.75182 14.9375 12.2478 16.01C12.8415 16.265 13.3054 16.4175 13.6662 16.5317C14.2624 16.72 14.805 16.6933 15.2337 16.63C15.7118 16.5592 16.7057 16.0308 16.9133 15.4525C17.121 14.8733 17.121 14.3775 17.0582 14.2742Z" /></svg>{en === 'foot' && `WhatsApp ${contacto.tel}`}</a>

<style>
  /* ---------- en los footers (fondo navy): icono en el verde de WhatsApp, texto como los demás enlaces ---------- */
  .wa--foot { display: inline-flex; align-items: center; gap: 8px; }
  .wa--foot svg { flex: none; color: #25d366; }

  /* ---------- flotante: siempre a la mano, abajo a la derecha ----------
     El verde es un tono más oscuro que el de la marca (#25D366) para que el icono blanco llegue a 3:1 de contraste. */
  .wa--flotante {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1da851;
    color: #fff;
    box-shadow: 0 10px 24px -8px rgba(13, 22, 107, 0.45), 0 2px 6px rgba(13, 22, 107, 0.18);
    transition: transform 0.15s, background-color 0.15s, opacity 0.2s, visibility 0s;
  }
  .wa--flotante:hover { background: #178f45; transform: translateY(-2px); }
  .wa--flotante:active { transform: none; }
  .wa--flotante:focus-visible { border-radius: 50%; outline: 3px solid #0d166b; outline-offset: 3px; }
  /* al llegar al footer, que ya trae su enlace a WhatsApp, el flotante se retira para no tapar el pie */
  .wa--flotante.is-oculto { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity 0.2s, visibility 0s 0.2s; }
  @media (prefers-reduced-motion: reduce) {
    .wa--flotante, .wa--flotante.is-oculto { transition: none; }
    .wa--flotante:hover { transform: none; }
  }
  @media print { .wa--flotante { display: none; } }
</style>

<script>
  // Microsoft Clarity: cuenta los clics a WhatsApp y desde dónde (window.clarity solo existe en producción)
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest?.('[data-wa]');
    const c = (window as unknown as { clarity?: (...args: unknown[]) => void }).clarity;
    if (!a || typeof c !== 'function') return;
    try {
      c('event', 'whatsapp_click');
      c('set', 'whatsapp_origen', a.getAttribute('data-wa') || 'enlace');
    } catch { /* sin Clarity */ }
  });

  // El flotante se retira mientras se ve un footer que ya tiene su propio enlace a WhatsApp
  const flotante = document.querySelector<HTMLElement>('.wa--flotante');
  const pie = document.querySelector('footer');
  if (flotante && pie?.querySelector('[data-wa]') && 'IntersectionObserver' in window) {
    new IntersectionObserver(([f]) => flotante.classList.toggle('is-oculto', f.isIntersecting)).observe(pie);
  }
</script>
