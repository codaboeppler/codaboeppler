<script>
  import GLOBE_DOTS from '../data/globe-dots.json';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- POS hero: the purple glow blooms behind the tablet on entry ---------- */
  const posHero = document.querySelector<HTMLElement>('[data-poshero]');
  if (posHero) {
    if (reduce) posHero.classList.add('is-in');
    else {
      const hio = new IntersectionObserver(
        (entries) => {
          if (entries.some((en) => en.isIntersecting)) {
            posHero.classList.add('is-in');
            hio.disconnect();
          }
        },
        { threshold: 0.3 }
      );
      hio.observe(posHero);
    }
  }

  /* ---------- la red ataskate: dotted globe over Mexico ----------
     Canvas 2D, no libraries. Land dots baked from world-atlas at build time
     (scripts/build-globe-dots.mjs; Mexico sampled 2x denser). The camera is
     locked around Mexico — the visitor can nudge it, not spin it away — and
     a dense arc network pulses between casas de empeño. */
  const globeCanvas = document.querySelector<HTMLCanvasElement>('[data-globe]');
  if (globeCanvas) {
    const ctx = globeCanvas.getContext('2d')!;
    const D2R = Math.PI / 180;
    const LON0 = -100.5; // centre of the view
    const LAT0 = 22.5;

    const pts = (GLOBE_DOTS as [number, number][]).map(([lat, lon]) => {
      const la = lat * D2R;
      const lo = lon * D2R;
      return {
        x: Math.cos(la) * Math.cos(lo),
        y: Math.sin(la),
        z: Math.cos(la) * Math.sin(lo),
        mx: lat > 14 && lat < 33.5 && lon > -118.5 && lon < -86,
      };
    });

    const CITIES: Record<string, [number, number]> = {
      tijuana: [32.52, -117.03],
      hermosillo: [29.07, -110.95],
      chihuahua: [28.63, -106.08],
      juarez: [31.69, -106.42],
      culiacan: [24.8, -107.39],
      torreon: [25.54, -103.44],
      saltillo: [25.42, -101.0],
      monterrey: [25.67, -100.31],
      slp: [22.15, -100.98],
      leon: [21.12, -101.68],
      queretaro: [20.59, -100.39],
      guadalajara: [20.67, -103.35],
      morelia: [19.7, -101.19],
      cdmx: [19.43, -99.13],
      puebla: [19.04, -98.2],
      veracruz: [19.17, -96.13],
      oaxaca: [17.07, -96.72],
      tuxtla: [16.75, -93.12],
      cancun: [21.16, -86.85],
      merida: [20.97, -89.62],
    };
    const cityVec = ([lat, lon]: [number, number]) => {
      const la = lat * D2R;
      const lo = lon * D2R;
      return { x: Math.cos(la) * Math.cos(lo), y: Math.sin(la), z: Math.cos(la) * Math.sin(lo) };
    };
    // Dense network across the country, hubbed on CDMX / Monterrey / GDL.
    const LINKS: [string, string][] = [
      ['cdmx', 'tijuana'],
      ['cdmx', 'monterrey'],
      ['cdmx', 'merida'],
      ['cdmx', 'guadalajara'],
      ['cdmx', 'oaxaca'],
      ['cdmx', 'veracruz'],
      ['cdmx', 'cancun'],
      ['monterrey', 'juarez'],
      ['monterrey', 'saltillo'],
      ['monterrey', 'torreon'],
      ['monterrey', 'slp'],
      ['guadalajara', 'culiacan'],
      ['guadalajara', 'hermosillo'],
      ['guadalajara', 'leon'],
      ['leon', 'queretaro'],
      ['queretaro', 'slp'],
      ['morelia', 'guadalajara'],
      ['puebla', 'oaxaca'],
      ['tuxtla', 'merida'],
      ['chihuahua', 'torreon'],
      ['tijuana', 'hermosillo'],
    ];
    const ARCS = LINKS.map(([a, b], i) => {
      const va = cityVec(CITIES[a]);
      const vb = cityVec(CITIES[b]);
      const om = Math.acos(Math.max(-1, Math.min(1, va.x * vb.x + va.y * vb.y + va.z * vb.z)));
      return {
        a: va,
        b: vb,
        om,
        off: (i * 0.47) % 1,
        speed: 0.00009 + (i % 5) * 0.000018,
        prev: -1,
      };
    });
    // Arrival ripples: spawned at an arc's destination when a comet lands.
    const ripples: { p: { x: number; y: number; z: number }; born: number }[] = [];

    const CITY_NAMES: Record<string, string> = {
      tijuana: 'Tijuana',
      hermosillo: 'Hermosillo',
      chihuahua: 'Chihuahua',
      juarez: 'Cd. Juárez',
      culiacan: 'Culiacán',
      torreon: 'Torreón',
      saltillo: 'Saltillo',
      monterrey: 'Monterrey',
      slp: 'San Luis Potosí',
      leon: 'León',
      queretaro: 'Querétaro',
      guadalajara: 'Guadalajara',
      morelia: 'Morelia',
      cdmx: 'CDMX',
      puebla: 'Puebla',
      veracruz: 'Veracruz',
      oaxaca: 'Oaxaca',
      tuxtla: 'Tuxtla Gutiérrez',
      cancun: 'Cancún',
      merida: 'Mérida',
    };
    // Little life events that hop between branches.
    const POP_EVENTS = [
      { t: 'Artículo nuevo', s: 'Anillo de oro 14k' },
      { t: 'Bajó el tabulador de oro', s: 'Actualizado en tiempo real' },
      { t: 'Venta en Marketplace', s: 'iPhone 15 Pro Max' },
      { t: 'Refrendo cobrado', s: 'Contrato A-1042' },
      { t: 'Empeño nuevo', s: 'Laptop 14 pulgadas' },
      { t: 'Desempeño en línea', s: 'Pagado desde el celular' },
      { t: 'Corte de caja cuadrado', s: 'Turno vespertino' },
    ];

    const slerp = (a: any, b: any, t: number) => {
      const dot = Math.max(-1, Math.min(1, a.x * b.x + a.y * b.y + a.z * b.z));
      const om = Math.acos(dot);
      const so = Math.sin(om) || 1e-6;
      const ka = Math.sin((1 - t) * om) / so;
      const kb = Math.sin(t * om) / so;
      const lift = 1 + 0.055 * Math.sin(Math.PI * t) * Math.min(1.6, om / 0.22);
      return {
        x: (ka * a.x + kb * b.x) * lift,
        y: (ka * a.y + kb * b.y) * lift,
        z: (ka * a.z + kb * b.z) * lift,
      };
    };

    // Static ambient sparkles in the sky band above the horizon.
    const SPARKS = Array.from({ length: 36 }, (_, i) => ({
      u: ((i * 73) % 97) / 97,
      v: ((i * 41) % 89) / 89,
      s: 0.5 + ((i * 53) % 100) / 140,
    }));

    let W = 0;
    let H = 0;
    const fit = () => {
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      const r = globeCanvas.getBoundingClientRect();
      W = Math.round(r.width * dpr);
      H = Math.round(r.height * dpr);
      globeCanvas.width = W;
      globeCanvas.height = H;
    };
    fit();
    window.addEventListener('resize', () => {
      fit();
      if (reduce) drawGlobe(0);
    });

    /* Zoom: the button glides the camera in for a detailed look — city
       labels fade in as it closes. */
    let zoom = 0;
    let zoomTarget = 0;
    const zoomBtn = document.querySelector<HTMLButtonElement>('[data-netzoom]');
    zoomBtn?.addEventListener('click', () => {
      zoomTarget = zoomTarget ? 0 : 1;
      zoomBtn.setAttribute('aria-pressed', String(!!zoomTarget));
      zoomBtn.setAttribute('aria-label', zoomTarget ? 'Alejar el mapa' : 'Acercar el mapa');
      const g = zoomBtn.querySelector('span');
      if (g) g.textContent = zoomTarget ? '−' : '+';
      if (reduce) drawGlobe(performance.now());
    });

    /* Nudge, not spin: Mexico stays on stage. */
    let userLon = 0;
    let userLat = 0;
    let velLon = 0;
    let velLat = 0;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    const LON_MAX = 16;
    const LAT_MAX = 10;
    globeCanvas.style.touchAction = 'pan-y';
    globeCanvas.style.cursor = 'grab';
    globeCanvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      lastX = e.clientX;
      lastY = e.clientY;
      globeCanvas.setPointerCapture(e.pointerId);
      globeCanvas.style.cursor = 'grabbing';
    });
    globeCanvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const k = 0.22;
      velLon = (e.clientX - lastX) * k;
      velLat = (e.clientY - lastY) * k;
      userLon = Math.max(-LON_MAX, Math.min(LON_MAX, userLon + velLon));
      userLat = Math.max(-LAT_MAX, Math.min(LAT_MAX, userLat + velLat));
      lastX = e.clientX;
      lastY = e.clientY;
      if (reduce) drawGlobe(performance.now());
    });
    const endDrag = () => {
      dragging = false;
      globeCanvas.style.cursor = 'grab';
    };
    globeCanvas.addEventListener('pointerup', endDrag);
    globeCanvas.addEventListener('pointercancel', endDrag);

    // View centre, solved numerically each frame so Mexico always sits at
    // the same screen anchor no matter the canvas size.
    let lon0v = LON0;
    let lat0v = LAT0;
    const MX_ANCHOR = cityVec([23.2, -102.2]);

    const drawGlobe = (t: number) => {
      // The sphere dwarfs the frame: its curved horizon sweeps the top-right
      // corner while Mexico holds centre stage.
      // Bigger and pushed left: only the right ~80% of the dome shows,
      // rolled a few degrees so the planet leans into the copy.
      // Ease toward the zoom target; the anchor solver keeps Mexico put.
      zoom += (zoomTarget - zoom) * (reduce ? 1 : 0.07);
      if (Math.abs(zoomTarget - zoom) < 0.001) zoom = zoomTarget;
      const cx = W * (0.33 + 0.13 * zoom);
      const cy = H * (1.05 + 0.5 * zoom);
      const R = W * (0.63 + 0.75 * zoom);
      const ROLL = -9 * D2R;
      const sR = Math.sin(ROLL);
      const cR = Math.cos(ROLL);
      ctx.clearRect(0, 0, W, H);

      // Solve the view centre so Mexico lands on the anchor point.
      {
        const ax = W * 0.46;
        const ay = H * 0.56;
        const cosM = Math.cos(23.2 * D2R);
        for (let k = 0; k < 6; k++) {
          const sp = (lon0v - 90) * D2R;
          const ti = lat0v * D2R;
          const x1 = MX_ANCHOR.x * Math.cos(sp) + MX_ANCHOR.z * Math.sin(sp);
          const z1 = -MX_ANCHOR.x * Math.sin(sp) + MX_ANCHOR.z * Math.cos(sp);
          const y2 = MX_ANCHOR.y * Math.cos(ti) - z1 * Math.sin(ti);
          const dx = -x1 * R;
          const dy = -y2 * R;
          const sx = cx + dx * cR - dy * sR;
          const sy = cy + dx * sR + dy * cR;
          lon0v += (sx - ax) / (R * cosM * D2R);
          lat0v -= (sy - ay) / (R * D2R);
        }
      }

      // Inertia decay + gentle re-centering when free.
      if (!dragging) {
        velLon *= 0.92;
        velLat *= 0.92;
        userLon = Math.max(-LON_MAX, Math.min(LON_MAX, (userLon + velLon) * 0.985));
        userLat = Math.max(-LAT_MAX, Math.min(LAT_MAX, (userLat + velLat) * 0.985));
      }

      // Ambient sparkles in the sky, skipping anything over the sphere.
      for (const sp of SPARKS) {
        const sx = sp.u * W;
        const sy = sp.v * H * 0.55;
        const dx = sx - cx;
        const dy = sy - cy;
        if (dx * dx + dy * dy < R * R * 1.02) continue;
        ctx.beginPath();
        ctx.arc(sx, sy, sp.s * (W / 640), 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(90, 90, 255, 0.15)';
        ctx.fill();
      }

      // Atmosphere hugging the horizon, then the sphere base.
      const halo = ctx.createRadialGradient(cx, cy, R * 0.985, cx, cy, R * 1.09);
      halo.addColorStop(0, 'rgba(213, 164, 255, 0.34)');
      halo.addColorStop(1, 'rgba(213, 164, 255, 0)');
      ctx.fillStyle = halo;
      ctx.fillRect(0, 0, W, H);

      const base = ctx.createRadialGradient(cx, cy, R * 0.55, cx, cy, R);
      base.addColorStop(0, '#FDFCFF');
      base.addColorStop(0.78, '#F4F2FF');
      base.addColorStop(1, '#E5E2FA');
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.fillStyle = base;
      ctx.fill();

      // Inner rim shadow: the atmosphere edge that sells the sphere.
      const rim = ctx.createRadialGradient(cx, cy, R * 0.82, cx, cy, R);
      rim.addColorStop(0, 'rgba(90, 90, 255, 0)');
      rim.addColorStop(0.85, 'rgba(90, 90, 255, 0.05)');
      rim.addColorStop(1, 'rgba(63, 60, 200, 0.16)');
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.fillStyle = rim;
      ctx.fill();
      ctx.strokeStyle = 'rgba(90, 90, 255, 0.22)';
      ctx.lineWidth = Math.max(1, W / 640);
      ctx.stroke();

      /* Orthographic projection centred on (LAT0, LON0 + nudge).
         The -90 offset puts the target longitude at max depth instead of the
         limb, and sx flips x so east lands on the right — both were wrong in
         the first cut and put Mexico on the edge of the sphere. */
      const sway = dragging ? 0 : Math.sin(t * 0.00015) * 3.5 * (1 - zoom * 0.75);
      const spin = (lon0v + userLon + sway - 90) * D2R;
      const tilt = (lat0v + userLat) * D2R;
      const sSp = Math.sin(spin);
      const cSp = Math.cos(spin);
      const sTi = Math.sin(tilt);
      const cTi = Math.cos(tilt);
      const proj = (p: { x: number; y: number; z: number }) => {
        const x1 = p.x * cSp + p.z * sSp;
        const z1 = -p.x * sSp + p.z * cSp;
        const y2 = p.y * cTi - z1 * sTi;
        const z2 = p.y * sTi + z1 * cTi;
        const dx = -x1 * R;
        const dy = -y2 * R;
        return { sx: cx + dx * cR - dy * sR, sy: cy + dx * sR + dy * cR, z: z2 };
      };

      // Faint graticule: gives the ocean areas craft without noise.
      ctx.strokeStyle = 'rgba(90, 90, 255, 0.07)';
      ctx.lineWidth = Math.max(0.7, W / 1300);
      const strokeLine = (points: { sx: number; sy: number; z: number }[]) => {
        let pen = false;
        ctx.beginPath();
        for (const q of points) {
          if (q.z <= 0.02) {
            pen = false;
            continue;
          }
          if (!pen) {
            ctx.moveTo(q.sx, q.sy);
            pen = true;
          } else ctx.lineTo(q.sx, q.sy);
        }
        ctx.stroke();
      };
      for (let lon = -180; lon < 180; lon += 20) {
        const pl: any[] = [];
        for (let lat = -80; lat <= 80; lat += 5) pl.push(proj(cityVec([lat, lon])));
        strokeLine(pl);
      }
      for (let lat = -60; lat <= 75; lat += 15) {
        const pl: any[] = [];
        for (let lon = -180; lon <= 180; lon += 5) pl.push(proj(cityVec([lat, lon])));
        strokeLine(pl);
      }

      // Land dots — Mexico glows brighter than the rest of the world.
      for (const p of pts) {
        const q = proj(p);
        if (q.z <= 0.02) continue;
        if (q.sx < -8 || q.sx > W + 8 || q.sy < -8 || q.sy > H + 8) continue;
        const a = 0.08 + 0.5 * q.z;
        if (p.mx) {
          ctx.beginPath();
          ctx.arc(q.sx, q.sy, 1.35 * (W / 640), 0, Math.PI * 2);
          ctx.fillStyle = `rgba(90, 90, 255, ${Math.min(1, a + 0.4)})`;
          ctx.fill();
        } else {
          ctx.beginPath();
          ctx.arc(q.sx, q.sy, (0.75 + 0.8 * q.z) * (W / 640), 0, Math.PI * 2);
          ctx.fillStyle = `rgba(13, 22, 107, ${a})`;
          ctx.fill();
        }
      }

      /* Arcs — layered feathering instead of one fat glow: three strokes of
         rising opacity and falling width read as a soft beam. The gradient
         fades out at both endpoints so no line ever "cuts" into a city. */
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      for (const arc of ARCS) {
        const pa = proj(arc.a);
        const pb = proj(arc.b);
        const grad = ctx.createLinearGradient(pa.sx, pa.sy, pb.sx, pb.sy);
        grad.addColorStop(0, 'rgba(122, 90, 255, 0)');
        grad.addColorStop(0.18, 'rgba(110, 90, 255, 0.35)');
        grad.addColorStop(0.5, 'rgba(122, 90, 255, 0.44)');
        grad.addColorStop(0.82, 'rgba(150, 90, 255, 0.35)');
        grad.addColorStop(1, 'rgba(122, 90, 255, 0)');

        ctx.beginPath();
        for (let i = 0; i <= 40; i++) {
          const q = proj(slerp(arc.a, arc.b, i / 40));
          if (i === 0) ctx.moveTo(q.sx, q.sy);
          else ctx.lineTo(q.sx, q.sy);
        }
        ctx.strokeStyle = 'rgba(122, 90, 255, 0.05)';
        ctx.lineWidth = Math.max(4, W / 240);
        ctx.stroke();
        ctx.strokeStyle = 'rgba(122, 90, 255, 0.1)';
        ctx.lineWidth = Math.max(2, W / 480);
        ctx.stroke();
        ctx.strokeStyle = grad;
        ctx.lineWidth = Math.max(1, W / 900);
        ctx.stroke();

        if (!reduce) {
          const head = (t * arc.speed + arc.off) % 1;
          // A comet landed: spawn a ripple at the destination.
          if (arc.prev >= 0 && head < arc.prev) ripples.push({ p: arc.b, born: t });
          arc.prev = head;

          // Long, silky tail: many short segments, alpha and width easing
          // toward the head, hue drifting violet → pink.
          const TAIL = Math.min(0.42, 0.16 + arc.om * 1.1);
          const SEG = 26;
          for (let i = 0; i < SEG; i++) {
            const t1 = head - TAIL + (TAIL * i) / SEG;
            const t2 = head - TAIL + (TAIL * (i + 1)) / SEG;
            if (t2 <= 0) continue;
            const q1 = proj(slerp(arc.a, arc.b, Math.max(0, t1)));
            const q2 = proj(slerp(arc.a, arc.b, Math.min(1, t2)));
            const f = (i + 1) / SEG;
            const ease = f * f * (3 - 2 * f);
            const rC = Math.round(122 + (255 - 122) * ease);
            const gC = Math.round(90 + (106 - 90) * ease);
            const bC = Math.round(255 + (232 - 255) * ease);
            ctx.beginPath();
            ctx.moveTo(q1.sx, q1.sy);
            ctx.lineTo(q2.sx, q2.sy);
            ctx.strokeStyle = `rgba(${rC}, ${gC}, ${bC}, ${(0.62 * ease).toFixed(3)})`;
            ctx.lineWidth = Math.max(0.7, (W / 430) * ease);
            ctx.stroke();
          }

          // Head: layered halo + white-hot core.
          const hq = proj(slerp(arc.a, arc.b, head));
          const halo1 = ctx.createRadialGradient(hq.sx, hq.sy, 0, hq.sx, hq.sy, W / 95);
          halo1.addColorStop(0, 'rgba(255, 106, 232, 0.5)');
          halo1.addColorStop(1, 'rgba(255, 106, 232, 0)');
          ctx.beginPath();
          ctx.arc(hq.sx, hq.sy, W / 95, 0, Math.PI * 2);
          ctx.fillStyle = halo1;
          ctx.fill();
          const halo2 = ctx.createRadialGradient(hq.sx, hq.sy, 0, hq.sx, hq.sy, W / 260);
          halo2.addColorStop(0, 'rgba(255, 255, 255, 0.95)');
          halo2.addColorStop(0.6, 'rgba(255, 176, 240, 0.7)');
          halo2.addColorStop(1, 'rgba(255, 176, 240, 0)');
          ctx.beginPath();
          ctx.arc(hq.sx, hq.sy, W / 260, 0, Math.PI * 2);
          ctx.fillStyle = halo2;
          ctx.fill();
        }
      }

      // Arrival ripples: two expanding rings that fade as they grow.
      if (!reduce) {
        for (let i = ripples.length - 1; i >= 0; i--) {
          const rp = ripples[i];
          const age = (t - rp.born) / 1100;
          if (age >= 1) {
            ripples.splice(i, 1);
            continue;
          }
          const q = proj(rp.p);
          if (q.z <= 0) continue;
          for (const [lag, wgt] of [
            [0, 1],
            [0.25, 0.55],
          ] as [number, number][]) {
            const a2 = age - lag;
            if (a2 <= 0) continue;
            const ease = 1 - Math.pow(1 - a2, 2);
            ctx.beginPath();
            ctx.arc(q.sx, q.sy, (W / 34) * ease, 0, Math.PI * 2);
            ctx.strokeStyle = `rgba(122, 90, 255, ${((1 - a2) * 0.5 * wgt).toFixed(3)})`;
            ctx.lineWidth = Math.max(0.8, (W / 640) * (1.6 - a2));
            ctx.stroke();
          }
        }
      }

      // City markers: quiet glow, white ring, indigo core — hubs read first.
      for (const key of Object.keys(CITIES)) {
        const q = proj(cityVec(CITIES[key]));
        if (q.z <= 0) continue;
        const hub = key === 'cdmx' || key === 'monterrey' || key === 'guadalajara';
        const rr = hub ? W / 170 : W / 240;
        const g = ctx.createRadialGradient(q.sx, q.sy, 0, q.sx, q.sy, rr);
        g.addColorStop(0, 'rgba(90, 90, 255, 0.32)');
        g.addColorStop(1, 'rgba(90, 90, 255, 0)');
        ctx.beginPath();
        ctx.arc(q.sx, q.sy, rr, 0, Math.PI * 2);
        ctx.fillStyle = g;
        ctx.fill();
        ctx.beginPath();
        ctx.arc(q.sx, q.sy, hub ? W / 300 : W / 400, 0, Math.PI * 2);
        ctx.fillStyle = '#FFFFFF';
        ctx.fill();
        ctx.beginPath();
        ctx.arc(q.sx, q.sy, hub ? W / 460 : W / 640, 0, Math.PI * 2);
        ctx.fillStyle = '#5A5AFF';
        ctx.fill();
      }

      // City names appear as the camera closes in.
      if (zoom > 0.35) {
        const la = Math.min(1, (zoom - 0.35) / 0.5);
        ctx.font = `700 ${Math.max(10, W / 58)}px Nunito, sans-serif`;
        ctx.textBaseline = 'middle';
        for (const key of Object.keys(CITIES)) {
          const q = proj(cityVec(CITIES[key]));
          if (q.z <= 0.25) continue;
          if (q.sx < 0 || q.sx > W || q.sy < 0 || q.sy > H) continue;
          const name = CITY_NAMES[key];
          const pad = W / 90;
          ctx.fillStyle = `rgba(255, 255, 255, ${(la * 0.85).toFixed(3)})`;
          const tw = ctx.measureText(name).width;
          ctx.beginPath();
          ctx.roundRect(q.sx + pad - 4, q.sy - W / 80, tw + 10, W / 40, 6);
          ctx.fill();
          ctx.fillStyle = `rgba(13, 22, 107, ${la.toFixed(3)})`;
          ctx.fillText(name, q.sx + pad + 1, q.sy + 1);
        }
      }

      // Specular sheen on top, very faint — clipped to the sphere.
      const sheen = ctx.createRadialGradient(
        W * 0.5,
        H * 0.08,
        0,
        W * 0.5,
        H * 0.08,
        W * 0.62,
      );
      sheen.addColorStop(0, 'rgba(255, 255, 255, 0.35)');
      sheen.addColorStop(1, 'rgba(255, 255, 255, 0)');
      ctx.save();
      ctx.beginPath();
      ctx.arc(cx, cy, R, 0, Math.PI * 2);
      ctx.clip();
      ctx.fillStyle = sheen;
      ctx.fillRect(0, 0, W, H);
      ctx.restore();

      if (!reduce) popTick(t, proj);
    };

    /* Branch popups: one at a time, hopping between front-facing cities. */
    const popEl = document.querySelector<HTMLElement>('[data-netpop]');
    const popT = document.querySelector<HTMLElement>('[data-netpop-t]');
    const popS = document.querySelector<HTMLElement>('[data-netpop-s]');
    let popCity = '';
    let popPhase = 0; // timestamp of next phase change
    let popShown = false;
    let popIdx = 0;
    const cityKeys = Object.keys(CITIES);
    const popTick = (t: number, projFn: (p: any) => { sx: number; sy: number; z: number }) => {
      if (!popEl || !popT || !popS) return;
      if (t > popPhase) {
        if (popShown) {
          popEl.classList.remove('is-on');
          popShown = false;
          popPhase = t + 900; // gap before the next one
        } else {
          // pick the next event on a city that currently faces the camera
          for (let tries = 0; tries < 8; tries++) {
            const key = cityKeys[Math.floor(Math.random() * cityKeys.length)];
            const q = projFn(cityVec(CITIES[key]));
            if (q.z > 0.25 && q.sy > H * 0.18) {
              popCity = key;
              break;
            }
          }
          if (!popCity) {
            popPhase = t + 800;
            return;
          }
          const ev = POP_EVENTS[popIdx % POP_EVENTS.length];
          popIdx++;
          popT.textContent = ev.t;
          popS.textContent = `${ev.s} · ${CITY_NAMES[popCity] || 'CDMX'}`;
          popEl.hidden = false;
          popEl.classList.add('is-on');
          popShown = true;
          popPhase = t + 2600; // how long it stays up
        }
      }
      if (popCity) {
        const q = projFn(cityVec(CITIES[popCity]));
        const dpr = Math.min(2, window.devicePixelRatio || 1);
        popEl.style.left = `${(q.sx / dpr).toFixed(1)}px`;
        popEl.style.top = `${(q.sy / dpr).toFixed(1)}px`;
        if (q.z <= 0.05 && popShown) {
          popEl.classList.remove('is-on');
          popShown = false;
          popPhase = t + 600;
        }
      }
    };

    if (reduce) {
      drawGlobe(0);
    } else {
      let playing = false;
      let gRaf = 0;
      const loop = (now: number) => {
        if (!playing) {
          gRaf = 0;
          return;
        }
        drawGlobe(now);
        gRaf = requestAnimationFrame(loop);
      };
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            playing = e.isIntersecting;
            if (playing) {
              cancelAnimationFrame(gRaf);
              gRaf = requestAnimationFrame(loop);
            }
          }
        },
        { threshold: 0.05 },
      );
      io.observe(globeCanvas);
      drawGlobe(0);
    }
  }

  /* ---------- mobile menu ---------- */
  const burger = document.querySelector<HTMLButtonElement>('[data-menu]');
  const menu = document.getElementById('mast-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Abrir menú' : 'Cerrar menú');
    menu?.classList.toggle('is-open', !open);
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).tagName !== 'A') return;
    menu.classList.remove('is-open');
    burger?.setAttribute('aria-expanded', 'false');
  });

  /* ---------- step screenshots: swap with a depth pop ---------- */
  const shots = Array.from(document.querySelectorAll<HTMLElement>('[data-shot]'));
  let shotIdx = 0;
  const showShot = (i: number) => {
    if (i === shotIdx || !shots[i]) return;
    const prev = shots[shotIdx];
    const next = shots[i];
    shotIdx = i;
    prev.classList.remove('is-active');
    prev.classList.add('is-leaving');
    prev.addEventListener('animationend', () => prev.classList.remove('is-leaving'), { once: true });
    // Restart the entrance even if the class was applied recently.
    next.classList.remove('is-active', 'is-leaving');
    void next.offsetWidth;
    next.classList.add('is-active');
  };

  /* ---------- accordions (single open, click again to close) ---------- */
  document.querySelectorAll<HTMLElement>('[data-acc]').forEach((acc) => {
    const buttons = Array.from(acc.querySelectorAll<HTMLButtonElement>('.acc__btn'));
    buttons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        const wasOpen = btn.getAttribute('aria-expanded') === 'true';
        buttons.forEach((b) => {
          const open = b === btn && !wasOpen;
          b.setAttribute('aria-expanded', String(open));
          const sign = b.querySelector('.acc__sign');
          if (sign) sign.textContent = open ? '–' : '+';
          const panel = document.getElementById(b.getAttribute('aria-controls') || '');
          if (panel) panel.hidden = !open;
        });
        // The pasos accordion drives the screenshot panel next to it.
        if (!wasOpen && btn.id.startsWith('paso-btn-')) showShot(idx);
      });
    });
  });

  /* ---------- price toggle ---------- */
  const prices: Record<string, string> = { mensual: '$99', anual: '$79' };
  const priceEl = document.querySelector('[data-price]');
  document.querySelectorAll<HTMLButtonElement>('[data-toggle] button').forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelectorAll<HTMLButtonElement>('[data-toggle] button').forEach((b) => {
        const on = b === btn;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      const plan = btn.dataset.plan || 'mensual';
      if (priceEl) priceEl.textContent = prices[plan];
    });
  });

  /* ---------- demo request → prefilled mail ---------- */
  const demo = document.querySelector<HTMLFormElement>('[data-demo]');
  // Microsoft Clarity: eventos y etiquetas del formulario (window.clarity solo existe en producción)
  const clarity = (...args: unknown[]) => {
    const c = (window as unknown as { clarity?: (...a: unknown[]) => void }).clarity;
    if (typeof c === 'function') { try { c(...args); } catch { /* sin Clarity */ } }
  };
  const datosDemo = () => {
    const fd = new FormData(demo!);
    const g = (k: string) => String(fd.get(k) ?? '').trim();
    return {
      nombre: g('nombre'), negocio: g('negocio'), rfc: g('rfc'), correo: g('correo'), telefono: g('telefono'),
      sucursales: g('sucursales'), empresa_web: g('empresa_web'), pagina: location.href,
    };
  };
  // RFC: se guarda en mayúsculas y sin espacios ni guiones, que es como lo valida el pattern
  const rfc = demo?.querySelector<HTMLInputElement>('[data-rfc]');
  rfc?.addEventListener('input', () => {
    const limpio = rfc.value.toUpperCase().replace(/[\s-]/g, '');
    if (limpio !== rfc.value) {
      const fin = (rfc.selectionStart ?? rfc.value.length) - (rfc.value.length - limpio.length);
      rfc.value = limpio;
      rfc.setSelectionRange(fin, fin);
    }
    rfc.setCustomValidity('');
  });
  const mailtoDemo = (d: ReturnType<typeof datosDemo>) => {
    const subject = encodeURIComponent('Solicitud de demo — ataskate');
    const body = encodeURIComponent(
      `Hola, quiero una demo de ataskate.\n\nNombre: ${d.nombre}\nNombre de negocio: ${d.negocio}\nRFC: ${d.rfc}\nCorreo: ${d.correo}\nTeléfono: ${d.telefono}\nSucursales: ${d.sucursales}\n`,
    );
    return `mailto:${demo?.dataset.mail || ''}?subject=${subject}&body=${body}`;
  };
  document.querySelectorAll<HTMLAnchorElement>('[data-wa]').forEach((a) => a.addEventListener('click', () => clarity('event', 'whatsapp_click')));
  demo?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const error = demo.querySelector<HTMLElement>('[data-error]')!;
    const submit = demo.querySelector<HTMLButtonElement>('[data-submit]')!;
    error.hidden = true;
    // validación del navegador campo por campo; el foco va al primero que falle
    let primero: HTMLInputElement | null = null;
    demo.querySelectorAll<HTMLInputElement>('input[required], input[type="email"]').forEach((el) => {
      if (el === rfc) {
        el.setCustomValidity('');
        if (el.validity.patternMismatch || el.validity.tooShort) {
          el.setCustomValidity('Escribe un RFC válido de 12 o 13 caracteres, por ejemplo EDC850101AB1.');
        }
      }
      const ok = el.checkValidity();
      el.setAttribute('aria-invalid', ok ? 'false' : 'true');
      if (!ok && !primero) primero = el;
    });
    if (primero) { (primero as HTMLInputElement).focus(); (primero as HTMLInputElement).reportValidity(); return; }

    const d = datosDemo();
    clarity('event', 'lead_form_submit');
    submit.disabled = true;
    const label = submit.textContent;
    submit.textContent = 'Enviando…';
    try {
      const r = await fetch(demo.dataset.api || '', {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d),
      });
      const res = await r.json().catch(() => ({}));
      if (!r.ok || !res.ok) throw new Error(res.error || ('HTTP ' + r.status));
      clarity('event', 'lead_form_success');
      clarity('set', 'lead_source', 'landing-cta');
      clarity('set', 'sucursales', d.sucursales);
      clarity('identify', d.correo);
      clarity('upgrade', 'lead-form');
      const done = document.querySelector<HTMLElement>('[data-done]')!;
      demo.hidden = true;
      done.hidden = false;
      done.focus();
    } catch {
      clarity('event', 'lead_form_error');
      error.innerHTML = 'No pudimos enviar tus datos. Intenta de nuevo o <a href="' + mailtoDemo(d) + '">escríbenos por correo</a>.';
      error.hidden = false;
      submit.disabled = false;
      submit.textContent = label;
    }
  });
  // Microsoft Clarity: eventos y etiquetas del formulario (window.clarity existe solo en producción)
  /* ---------- feature rail arrows ---------- */
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const railNav = document.querySelector<HTMLElement>('[data-rail-nav]');
  const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');
  if (rail && railNav && prev && next) {
    const syncRail = () => {
      const overflow = rail.scrollWidth - rail.clientWidth;
      railNav.hidden = overflow < 24;
      if (railNav.hidden) return;
      const x = rail.scrollLeft;
      prev.disabled = x < 8;
      next.disabled = x > overflow - 8;
      prev.classList.toggle('rail-btn--on', !prev.disabled);
      next.classList.toggle('rail-btn--on', !next.disabled);
    };
    const step = () => (rail.firstElementChild as HTMLElement)?.clientWidth + 16 || rail.clientWidth * 0.8;
    prev.addEventListener('click', () => rail.scrollBy({ left: -step(), behavior: reduce ? 'auto' : 'smooth' }));
    next.addEventListener('click', () => rail.scrollBy({ left: step(), behavior: reduce ? 'auto' : 'smooth' }));
    rail.addEventListener('scroll', syncRail, { passive: true });
    window.addEventListener('resize', syncRail, { passive: true });
    syncRail();
  }

  /* ---------- hero video → POS card flight ----------
     Both endpoints are read live every frame, so the video sits exactly on the
     hero slot at p=0 and exactly on the card's landing box at p=1, scrolling
     naturally with the page at either end. Only the trip between them is
     scroll-driven. Stacked layouts (<880px) keep the video in the hero. */
  const vid = document.querySelector<HTMLElement>('[data-vid]');
  const vidFrom = document.querySelector<HTMLElement>('[data-vid-from]');
  const vidTo = document.querySelector<HTMLElement>('[data-vid-to]');
  const media = vid?.querySelector('video');
  const heroEl = document.querySelector<HTMLElement>('.hero');
  /* True while a sibling feature card holds the wide slot: the POS video
     stays frozen on its frame, even when the flight would auto-resume it. */
  let fxHold = false;

  if (vid && vidFrom && vidTo && !reduce) {
    const wide = window.matchMedia('(min-width: 880px)');
    let flying = false;
    let raf = 0;

    const easeInOut = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

    const frame = () => {
      raf = 0;
      if (!flying) return;
      const a = vidFrom.getBoundingClientRect();
      const b = vidTo.getBoundingClientRect();
      if (!a.width || !b.width) return;

      const vh = window.innerHeight;
      const y = window.scrollY;
      const start = 40;
      // Land the video when the card's drop box reaches ~42% of the viewport.
      const end = Math.max(start + 240, b.top + y - vh * 0.42);
      const p = Math.min(1, Math.max(0, (y - start) / (end - start)));
      const e = easeInOut(p);

      const w = a.width + (b.width - a.width) * e;
      const h = a.height + (b.height - a.height) * e;
      const tx = a.left + (b.left - a.left) * e;
      const ty = a.top + (b.top - a.top) * e;

      vid.style.width = `${w.toFixed(1)}px`;
      vid.style.height = `${h.toFixed(1)}px`;
      vid.style.transform = `translate3d(${tx.toFixed(1)}px, ${ty.toFixed(1)}px, 0)`;
      // Corners travel from the hero's `0 24 24 0` to the card's `16 16 0 0`.
      const r = (from: number, to: number) => (from + (to - from) * e).toFixed(1);
      vid.style.borderRadius = `${r(0, 16)}px ${r(24, 16)}px ${r(24, 0)}px 0`;

      /* The element is only allowed to be visible in one of its two homes —
         inside the hero, or seated on the card. In between it dissolves, so it
         never floats over section copy on the way down. The card shows the
         poster the whole time, so the arrival is a seamless swap. */
      let alpha = 1;
      if (heroEl) {
        const hr = heroEl.getBoundingClientRect();
        const overlap = Math.min(ty + h, hr.bottom) - Math.max(ty, hr.top);
        const inHero = Math.max(0, Math.min(1, (overlap / h - 0.55) / 0.45));
        const gap = Math.hypot(tx - b.left, ty - b.top);
        const onCard = Math.max(0, Math.min(1, 1 - gap / 150));
        alpha = Math.max(inHero, onCard);
      }
      vid.style.opacity = alpha.toFixed(3);

      // Don't decode a video that is nowhere near the viewport. While a
      // sibling card holds the wide slot (fxHold), the POS stays frozen.
      if (media) {
        const onScreen = ty < vh && ty + h > 0;
        if (onScreen && media.paused && !fxHold) media.play().catch(() => {});
        else if ((!onScreen || fxHold) && !media.paused) media.pause();
      }
    };

    const tick = () => {
      if (raf) return;
      raf = requestAnimationFrame(frame);
    };

    const lift = () => {
      if (flying) return;
      flying = true;
      document.body.appendChild(vid);
      vid.classList.add('is-flying');
      // Place it synchronously: a fixed element with no width/height would
      // otherwise cover the viewport until the first animation frame lands
      // (which never happens while the tab is occluded).
      frame();
      // Re-parenting can drop the play state in some browsers.
      media?.play().catch(() => {});
    };

    const land = () => {
      if (!flying) return;
      flying = false;
      vid.classList.remove('is-flying');
      vid.removeAttribute('style');
      vidFrom.appendChild(vid);
      media?.play().catch(() => {});
    };

    const sync = () => (wide.matches ? lift() : land());
    sync();
    wide.addEventListener('change', sync);
    window.addEventListener('scroll', tick, { passive: true });
    // sync() on resize too: matchMedia change does not fire in every
    // viewport-change path (emulated resizes, some orientation changes).
    window.addEventListener(
      'resize',
      () => {
        sync();
        tick();
      },
      { passive: true },
    );
    // Coming back to a backgrounded tab: resolve the position without waiting.
    document.addEventListener('visibilitychange', () => {
      raf = 0;
      frame();
    });
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(tick);
      ro.observe(vidFrom);
      ro.observe(vidTo);
    }
    media?.addEventListener('loadedmetadata', tick);
  }

  /* ---------- suite highlights carousels: dots + arrows ---------- */
  document.querySelectorAll<HTMLElement>('[data-hl]').forEach((hl) => {
    const track = hl.querySelector<HTMLElement>('[data-hl-track]');
    const dotsBox = hl.querySelector<HTMLElement>('[data-hl-dots]');
    const prev = hl.querySelector<HTMLButtonElement>('[data-hl-prev]');
    const next = hl.querySelector<HTMLButtonElement>('[data-hl-next]');
    if (!track || !dotsBox || !prev || !next) return;
    const cards = Array.from(track.children) as HTMLElement[];
    const dots = cards.map((_, i) => {
      const d = document.createElement('span');
      d.className = 'hl__dot' + (i === 0 ? ' is-on' : '');
      dotsBox.appendChild(d);
      return d;
    });
    // Center-snap carousel: the active card is whichever sits closest to
    // the track's midline; arrows walk the index and center the target.
    // Rect-based: offsetLeft is relative to the positioned .hl wrapper (the
    // track bleeds with negative margins), so measure against the track.
    const centerOf = (el: HTMLElement) =>
      track.scrollLeft +
      (el.getBoundingClientRect().left - track.getBoundingClientRect().left) +
      el.offsetWidth / 2;
    const current = () => {
      const mid = track.scrollLeft + track.clientWidth / 2;
      let best = 0;
      let bestD = Infinity;
      cards.forEach((c, i) => {
        const d = Math.abs(centerOf(c) - mid);
        if (d < bestD) {
          bestD = d;
          best = i;
        }
      });
      return best;
    };
    const sync = () => {
      const i = current();
      dots.forEach((d, j) => d.classList.toggle('is-on', j === i));
      prev.disabled = i === 0;
      next.disabled = i === cards.length - 1;
      prev.classList.toggle('rail-btn--on', !prev.disabled);
      next.classList.toggle('rail-btn--on', !next.disabled);
    };
    // Rapid clicks walk one card at a time: while a smooth scroll is in
    // flight, step from the pending target instead of the live position.
    let pending = -1;
    let settle = 0;
    track.addEventListener(
      'scroll',
      () => {
        clearTimeout(settle);
        settle = window.setTimeout(() => {
          pending = -1;
        }, 140);
      },
      { passive: true },
    );
    const go = (dir: number) => {
      const base = pending >= 0 ? pending : current();
      const i = Math.max(0, Math.min(cards.length - 1, base + dir));
      pending = i;
      track.scrollTo({
        left: centerOf(cards[i]) - track.clientWidth / 2,
        behavior: reduce ? 'auto' : 'smooth',
      });
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });
    sync();
  });

  /* ---------- feature cards: hover hands over the wide slot ----------
     Only the track widths and the lila background move; the images are
     static. The POS video freezes while another card holds the slot. */
  const fxRail = document.querySelector<HTMLElement>('[data-rail]');
  const fxCards = Array.from(document.querySelectorAll<HTMLElement>('[data-fxcard]'));
  if (fxRail && fxCards.length) {
    const canHover = window.matchMedia('(min-width: 981px) and (hover: hover)');
    let fxIdx = 0;
    const setExp = (i: number) => {
      if (i === fxIdx) return;
      fxIdx = i;
      fxRail.dataset.exp = String(i);
      fxCards.forEach((c, j) => c.classList.toggle('is-exp', j === i));
      fxHold = i !== 0;
      if (fxHold) media?.pause();
      else media?.play().catch(() => {});
    };
    fxCards.forEach((c, i) => {
      c.addEventListener('pointerenter', () => {
        if (canHover.matches) setExp(i);
      });
    });
    fxRail.addEventListener('pointerleave', () => {
      if (canHover.matches) setExp(0);
    });
    // Falling back below the hover breakpoint restores the default layout.
    canHover.addEventListener('change', () => {
      if (!canHover.matches) setExp(0);
    });
  }

  /* ---------- POS grid popups: each capability card opens its demo ------ */
  document.querySelectorAll<HTMLElement>('[data-fpop]').forEach((btn) => {
    const d = document.getElementById(btn.dataset.fpop || '') as HTMLDialogElement | null;
    if (!d) return;
    const vid = d.querySelector<HTMLVideoElement>('video');
    let closing = 0;
    let y = 0;
    const open = () => {
      if (d.open) return;
      window.clearTimeout(closing);
      y = window.scrollY;
      d.showModal();
      document.body.style.overflow = 'hidden';
      /* showModal's focus move can nudge the page — pin it in place. */
      window.scrollTo({ top: y, behavior: 'instant' });
      requestAnimationFrame(() => {
        window.scrollTo({ top: y, behavior: 'instant' });
        requestAnimationFrame(() => d.classList.add('is-in'));
      });
      if (vid) vid.play().catch(() => {});
    };
    const shut = () => {
      if (!d.open) return;
      d.classList.remove('is-in');
      if (vid) vid.pause();
      closing = window.setTimeout(() => {
        d.close();
        document.body.style.overflow = '';
        /* close() re-focuses the trigger and the browser scrolls it into
           view — pin the page back where the visitor left it. */
        window.scrollTo({ top: y, behavior: 'instant' });
      }, 320);
    };
    btn.addEventListener('click', open);
    d.querySelector('[data-fpop-close]')?.addEventListener('click', shut);
    d.addEventListener('cancel', (e) => {
      e.preventDefault();
      shut();
    });
    d.addEventListener('click', (e) => {
      if (e.target === d) shut();
    });
  });

  /* ---------- text micro-reveals: gentle Apple-style fade-ups ----------
     Copy blocks only — cards, media and floating pills stay put. Re-arm on
     full exit so the fade replays when the visitor comes back. */
  if (!reduce) {
    const FADE_TARGETS = [
      '.hero__copy > *',
      '.suite .head--center > *',
      '.icard',
      '.suite__kicker:not([data-poskicker]) > *',
      '.mkt-hero__art',
      '.fg__card',
      '.hl__body > *',
      '.wall__copy > *',
      '.start__copy > *',
      '.net__copy > *',
      '.price .head--center > *',
      '.plan__head > *',
      '.plan__list li',
      '.faq .head--center > *',
      '.faq .acc__item',
      '.cta__inner > *',
    ].join(',');
    const fadeEls = Array.from(document.querySelectorAll<HTMLElement>(FADE_TARGETS));
    const fadeIO = new IntersectionObserver(
      (entries) => {
        let batch = 0;
        for (const e of entries) {
          const el = e.target as HTMLElement;
          if (e.isIntersecting && e.intersectionRatio >= 0.15) {
            if (el.classList.contains('tfx-in')) continue;
            el.style.setProperty('--fd', `${Math.min(batch++ * 80, 320)}ms`);
            el.classList.add('tfx-in');
          } else if (!e.isIntersecting) {
            el.classList.remove('tfx-in');
          }
        }
      },
      { threshold: [0, 0.15] },
    );
    for (const el of fadeEls) {
      el.classList.add('tfx');
      // On screen at load: no entrance flash, but armed for later replays.
      const r = el.getBoundingClientRect();
      if (r.top < window.innerHeight && r.bottom > 0) el.classList.add('tfx-in');
      fadeIO.observe(el);
    }
  }

  /* ---------- parallax (decorative, skipped when reduced) ---------- */
  if (!reduce) {
    const plx = Array.from(document.querySelectorAll<HTMLElement>('[data-plx]'));
    if (plx.length) {
      let queued = false;
      const onScroll = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => {
          queued = false;
          const vh = window.innerHeight;
          for (const el of plx) {
            const s = parseFloat(el.dataset.plx || '0');
            const p = el.parentElement?.getBoundingClientRect();
            if (!p) continue;
            const mid = p.top + p.height / 2 - vh / 2;
            const t = Math.max(-26, Math.min(26, -mid * s));
            el.style.transform = `translateY(${t.toFixed(1)}px)`;
          }
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }
</script>
