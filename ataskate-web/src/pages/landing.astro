---
/* ============================================================
   Landing ataskate — implementation of the "Landing ataskate"
   Claude Design mockup (project "ataskate landing mockup").
   Colours, type, spacing and copy come straight from the source
   template; the inline styles were re-expressed as scoped CSS and
   the DC template state (accordions, price toggle, parallax,
   reveals) as progressive-enhancement JS.
   ============================================================ */
import LandingLayout from '../layouts/LandingLayout.astro';
import DsIcon from '../components/DsIcon.astro';
import '../styles/suite-grid.css';
import '../styles/mast.css';
import '../styles/buttons.css';
import { posFunciones, sucursalPasos } from '../data/pos-funciones';
import { mktFunciones } from '../data/mkt-funciones';

const nav = [
  { href: '#top', label: 'Home' },
  { href: '/punto-de-venta/', label: 'POS' },
  { href: '/marketplace/', label: 'Marketplace' },
  { href: '/planes/', label: 'Precios' },
];

/* Trust points, floated as small pills around the hero video.
   `t`/`l`/`r` are the anchor offsets; they collapse to a plain wrapped row
   below 880px, where the hero stacks. */
const trust = [
  { label: 'Diseñado desde la operación real', bg: 'var(--purple-100)', fg: 'var(--navy)', t: '14%', l: 'auto', r: '5%', d: '-1.2s' },
  { label: 'Operación 100% digital', bg: 'var(--lemon-200)', fg: 'var(--ink)', t: '34%', l: 'auto', r: '17%', d: '-3.6s' },
  { label: 'Información protegida', bg: 'var(--pink-100)', fg: 'var(--ink)', t: '61%', l: 'auto', r: '7%', d: '-5.4s' },
  { label: 'Sin instalaciones', bg: '#FFFFFF', fg: 'var(--navy)', t: '80%', l: 'auto', r: '21%', d: '-2.5s' },
];

/* Suite bento under the hero: everything the system covers, one glance,
   grouped by product line (POS · Marketplace). */
/* Revolut-style intro: three clean portrait photos — caja, cartera prendaria
   y ventas del Marketplace. No overlays, the photos carry the section. */
const introCards = [
  { img: '/img/intro/caja.webp', alt: 'Avalúo de una cadena de oro en el mostrador' },
  { img: '/img/intro/prenda.webp', alt: 'Cliente recibiendo un reloj en la sucursal' },
  { img: '/img/intro/venta.webp', alt: 'Empaque de una pieza vendida en el Marketplace' },
];

const suite = {
  title: 'Todo lo que pasa entre recibir una prenda y venderla',
  sub: 'Cada parte de tu casa de empeño bajo control.',
  groups: [
    {
      kicker: 'Punto de venta',
      note: 'Administra tu operación de principio a fin.',
      items: posFunciones,
    },
    {
      kicker: 'ataskate merkado',
      note: 'Tu inventario conectado a una tienda que vende 24/7.',
      /* Same grammar as the POS grid: one card per Marketplace capability,
         named after the functionality. */
      items: mktFunciones,
    },
  ],
};



/* Promoted out of `beneficios` into its own band (the moving product wall). */
const alcance = {
  title: 'Tu inventario llega a los compradores',
  desc: 'Tu inventario se mueve porque se sincroniza con tu Marketplace tanto como con tu POS en tienda.',
};

/* Product wall: tiny tiles drifting sideways. Cut-outs on a light grey tile,
   same treatment as the ataskate marketplace product thumbs (#f0f1f3 +
   contain + multiply). Sources are the marketplace's own product renders,
   downscaled to 128px webp with their alpha intact. */
/* Ordered so no two phones or laptops sit next to each other. */
/* Themed rows — every line carries a different family of articles, no item
   repeats across rows. Each row cycles its own pool to fill one 24-tile loop. */
/* Mixed-variety rows — cameras, gold, consoles, jewelry, audio, phones —
   no article repeats across rows, and no ugly stock TV. New cutouts come
   from Wikimedia Commons (PD/CC) with backgrounds removed locally. */
const wallRowPools: string[][] = [
  ['iphone-titanio', 'camara', 'cadena-oro', 'laptop-plata', 'switch', 'reloj-tissot', 'bocina-jbl'],
  ['moneda-oro', 'macbook', 'iphone-desierto', 'smartwatch', 'anillos', 'consola', 'guitarra'],
  ['reloj', 'iphone-azul', 'laptop-negra', 'taladro', 'airpods', 'iphone-14', 'laptop-estelar'],
  ['iphone-negro', 'laptop-gris', 'iphone-blanco', 'iphone-natural16', 'iphone-negro16'],
];
const wallRows = wallRowPools.map((pool) =>
  Array.from({ length: 24 }, (_, i) => pool[i % pool.length]),
);

const beneficios = [
  {
    icon: 'UserUserGroup' as const,
    img: '/img/cliente-entra.webp',
    imgAlt: 'Un cliente entra sonriendo a una casa de empeño moderna',
    title: 'Conoces a tu cliente desde que entra',
    desc: 'Historial de préstamos, pagos y operaciones en un solo clic.',
  },
  {
    icon: 'DeviceLaptop' as const,
    title: 'Opera desde cualquier dispositivo',
    desc: 'Cobra, registra y cierra cada operación desde una sola pantalla.',
  },
];

const dolores = [
  {
    quote: 'Pierdo contratos y no sé qué prendas están vencidas',
    fix: 'Cada prenda tiene su historial completo: estado, plazo, cliente y valor.',
  },
  {
    quote: 'No sé cuánto dinero tengo en inventario parado',
    fix: 'Visibilidad en tiempo real de tu inventario prendario y artículos en venta.',
  },
  {
    quote: 'Tengo 3+ sucursales y no puedo verlas al mismo tiempo',
    fix: 'Un solo panel para todas, con reportes comparativos.',
  },
  {
    quote: 'Los artículos que no se rescatan se quedan parados',
    fix: 'Conviértelos en inventario de venta y súbelos al Marketplace.',
  },
];

/* The three onboarding steps — numbered 1·2·3 in the accordion. Each step
   carries the product screenshot the side panel swaps to when it opens. */
const pasos = [
  {
    title: 'Prueba la plataforma',
    desc: 'Agenda una demo con nuestro equipo o entra directo y explórala tú mismo. Sin instalaciones, sin compromiso.',
    cta: true, // only the first step invites contact
    shot: '/img/paso-prueba.webp',
    shotAlt: 'Panel Operativo de ataskate: caja, depositaria, almoneda y órdenes en una pantalla',
  },
  {
    title: 'Configura tu negocio',
    desc: 'Sucursales, usuarios y roles listos en minutos, no en semanas.',
    shot: '/img/paso-configura.webp',
    shotAlt: 'Admin de ataskate: perfil de sucursal con líneas de negocio, horarios y usuarios',
  },
  {
    title: 'Empieza a operar',
    desc: 'Cobra, presta y vende desde el mostrador desde el primer día.',
    shot: '/img/paso-operar.webp',
    shotAlt: 'Inventario comercial de ataskate con artículos, filtros y precios de venta',
  },
];

/* Roles + tamaño, split out of the steps into their own band. */
const medida = [
  {
    icon: 'UserUserGroup' as const,
    title: 'Roles de tu casa de empeño',
    desc: 'El dueño controla, el gerente supervisa, el operador atiende. Cada quien ve lo que necesita, nada más.',
  },
  {
    icon: 'DataChartMonitor' as const,
    title: 'Tamaño de tu operación',
    desc: 'De la casa de empeño independiente a la cadena con múltiples sucursales. ataskate crece contigo.',
  },
];

const marketplacePoints = [
  'ataskate pone tu vitrina digital, tú solo subes los artículos.',
  'Llega más lejos sin abrir otra sucursal.',
  'Más clientes, más rotación, más liquidez.',
];

/* Product cards in the marketplace band — same grammar as the real
   marketplace listing cards (photo on light panel, discount badge, "+N"
   photos chip, price + was-price), minus the kebab menu. */
const vitrina = [
  { img: 'iphone-titanio', title: 'iPhone 15 Pro Max 256GB', price: '$12,999', was: '$15,499', off: '-16%' },
  { img: 'laptop-plata', title: 'MacBook Air 13"', price: '$11,200', was: '$13,200', off: '-15%' },
  { img: 'cadena-oro', title: 'Cadena de oro 14k', price: '$5,900', was: '$6,500', off: '-9%' },
  { img: 'consola', title: 'Consola PS5', price: '$6,499', was: '$7,999', off: '-19%' },
];

/* Plan Esencial — the first plan of "planes 1.xlsx" (promo $99 / normal
   $149, por sucursal), with its feature groups from the "plan $99" sheet. */
const planIncluido = [
  'Usuarios ilimitados',
  '1 sucursal',
  'Hasta 5 bodegas',
  'Acceso desde cualquier dispositivo',
];
/* Only the highlights — the full matrix lives in /planes. */
const planTop = [
  'Cotiza metales con mejor referencia para cada valuación',
  'Vende y lleva el control de cada movimiento de caja',
  'Controla tu inventario del empeño a la venta',
  'Más formas de pagar, menos ventas detenidas',
  'Usuarios sin límite, permisos bajo control',
  'Lleva cada empeño de principio a fin: refrenda, abona o desempeña',
  'Controla entradas, salidas y efectivo real en caja',
  'Ubica cada artículo empeñado y controla cuándo pasa a venta',
];

const faqs = [
  {
    q: '¿Puedo cancelar cuando quiera?',
    a: 'Sí. No hay contratos forzosos ni penalizaciones: cancelas desde tu panel y conservas acceso hasta el fin de tu periodo pagado.',
  },
  {
    q: '¿ataskate funciona para más de una sucursal?',
    a: 'Sí. Agregas sucursales cuando quieras y las ves todas en un solo panel, con reportes comparativos y control centralizado.',
  },
  {
    q: '¿Qué tan rápido puedo empezar a usar el sistema?',
    a: 'El mismo día. Es 100% en la nube: configuras sucursales, usuarios y roles en minutos, sin instalaciones.',
  },
  {
    q: '¿Qué incluye exactamente mi plan?',
    a: 'Todo: operación prendaria, punto de venta, control de caja, roles y permisos, Marketplace, soporte y actualizaciones. Sin módulos extra.',
  },
];

const contacto = { tel: '55 6975 0198', email: 'ventas@ataskate.com' };
// WhatsApp Business de ventas: un clic abre el chat con un mensaje prellenado (icono en el navbar y enlace en el footer)
const WHATSAPP = 'https://wa.me/525569750198?text=' + encodeURIComponent('Hola, quiero más información de ataskate.');
// El formulario del CTA se envía a ventas por la función de Netlify del marketplace (Resend);
// el action mailto es el respaldo sin JS o si el servicio falla.
const CONTACTO_API = 'https://ataskate-marketplace-preview.netlify.app/api/enviar-contacto';
---

<LandingLayout>
  <!-- The POS card's media area shows this still until the hero video lands on
       it. It is only referenced from CSS, so preload it: otherwise the card can
       paint flat lila for a beat on a slow connection. -->
  <link slot="head" rel="preload" as="image" href="/video/landing-pos-poster.jpg" />

  <!-- ============================== HEADER ============================== -->
  <header class="mast">
    <div class="mast__bar">
      <a class="mast__brand" href="#top" aria-label="ataskate — inicio">
        <img src="/brand/ataskate-ink.svg" alt="ataskate" width="335" height="62" />
      </a>

      <nav class="mast__nav" id="mast-nav" aria-label="Principal">
        {nav.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>

      <a class="mast__wa" data-wa href={WHATSAPP} target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp" title="Escríbenos por WhatsApp"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true"><path d="M2 22L3.41254 16.8642C2.5409 15.3608 2.08289 13.6567 2.08373 11.9092C2.08624 6.44583 6.55329 2 12.0419 2C14.7053 2.00083 17.2056 3.03333 19.0862 4.90667C20.9659 6.78 22.0008 9.27 22 11.9183C21.9975 17.3825 17.5304 21.8283 12.0419 21.8283C10.3756 21.8275 8.73365 21.4117 7.27924 20.6217L2 22ZM7.52374 18.8275C8.92707 19.6567 10.2668 20.1533 12.0385 20.1542C16.6002 20.1542 20.3162 16.4592 20.3187 11.9167C20.3204 7.365 16.622 3.675 12.0452 3.67333C7.4802 3.67333 3.76673 7.36833 3.76505 11.91C3.76421 13.7642 4.31014 15.1525 5.22699 16.605L4.39052 19.645L7.52374 18.8275ZM17.0582 14.2742C16.9962 14.1708 16.8304 14.1092 16.5809 13.985C16.3322 13.8608 15.1089 13.2617 14.8803 13.1792C14.6526 13.0967 14.4868 13.055 14.3202 13.3033C14.1544 13.5508 13.6771 14.1092 13.5323 14.2742C13.3874 14.4392 13.2417 14.46 12.993 14.3358C12.7444 14.2117 11.9422 13.9508 10.9919 13.1067C10.2525 12.45 9.75266 11.6392 9.6078 11.3908C9.46295 11.1433 9.59273 11.0092 9.71665 10.8858C9.82885 10.775 9.96533 10.5967 10.0901 10.4517C10.2165 10.3083 10.2576 10.205 10.3413 10.0392C10.4242 9.87417 10.3832 9.72917 10.3204 9.605C10.2576 9.48167 9.76019 8.2625 9.55338 7.76667C9.35075 7.28417 9.14561 7.34917 8.99322 7.34167L8.51595 7.33333C8.35016 7.33333 8.08055 7.395 7.8528 7.64333C7.62505 7.89167 6.982 8.49 6.982 9.70917C6.982 10.9283 7.87373 12.1058 7.99765 12.2708C8.12241 12.4358 9.75182 14.9375 12.2478 16.01C12.8415 16.265 13.3054 16.4175 13.6662 16.5317C14.2624 16.72 14.805 16.6933 15.2337 16.63C15.7118 16.5592 16.7057 16.0308 16.9133 15.4525C17.121 14.8733 17.121 14.3775 17.0582 14.2742Z"/></svg></a>
      <a class="mast__login" href="#cta">Inicia sesión</a>
      <a class="btn btn--primary btn--sm mast__cta" href="#cta">Crear cuenta</a>

      <button
        class="mast__burger"
        type="button"
        data-menu
        aria-controls="mast-nav"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main id="main">
    <!-- ============================== HERO ============================== -->
    <!-- Cinematic hero: the counter footage runs full-bleed behind a left
         scrim, Shopify-style, with the copy in white on top. -->
    <section class="hero" id="top">
      <div class="hero__bg" aria-hidden="true">
        <img class="hero__img" src="/img/hero-home.webp" alt="" width="1669" height="942" fetchpriority="high" decoding="async" />
      </div>
      <div class="hero__scrim" aria-hidden="true"></div>

      <div class="hero__copy">
        <h1 class="hero__title">
          Una nueva forma de <em>operar</em> tu casa de empeño
        </h1>
        <p class="hero__lede">
          Conecta del empeño a la venta en un mismo lugar.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#funciones">Conoce ataskate</a>
        </div>
      </div>

      <ul class="hero__chips">
        {trust.map((t) => (
          <li style={`--t:${t.t};--l:${t.l};--r:${t.r};--d:${t.d};--bg:${t.bg};--fg:${t.fg}`}>
            {t.label}
          </li>
        ))}
      </ul>
    </section>

    <!-- ============================== FUNCIONES ============================== -->
    <!-- ============================== SUITE (bento bajo el hero) ============================== -->
    <section class="suite" id="funciones">
      <div class="intro">
        <div class="head head--center intro__head">
          <h2 class="h2 intro__title">{suite.title}</h2>
          <p class="lede intro__sub">{suite.sub}</p>
          <a class="btn btn--primary intro__cta" href="#cta">Crea tu cuenta</a>
        </div>
        <div class="intro__cards">
          {introCards.map((c, i) => (
            <figure class={`icard icard--${i}`}>
              <img src={c.img} alt={c.alt} width="900" height="1200" loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>

      {suite.groups.map((g, gi) => (
        <>
          {gi === 0 ? (
            /* Apple-style product shot: kicker centered, iPad frontal, and a
               purple glow that blooms behind it when the section enters. */
            <div class="pos-hero" data-poshero>
              <div class="suite__kicker suite__kicker--center">
                <span class="eyebrow">{g.kicker}</span>
                <p>{g.note}</p>
                <a class="btn btn--primary" href="/punto-de-venta/">Conoce todas sus funcionalidades</a>
              </div>
              <div class="pos-hero__stage">
                <figure class="branches__device pos-hero__device">
                  <video
                    src={sucursalPasos[0].clip}
                    poster="/video/suc-crear-poster.jpg"
                    width="1052"
                    height="708"
                    autoplay
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    aria-label="Recorrido del punto de venta de ataskate"
                  ></video>
                </figure>
              </div>
            </div>
          ) : (
            <div class="mkt-hero" id="marketplace" data-mkthero>
              <figure class="mkt-hero__art">
                <img src="/img/mkt-hero.webp" alt="Ilustración del Marketplace de ataskate" width="2000" height="407" loading="lazy" decoding="async" />
              </figure>
              <div class="suite__kicker suite__kicker--center">
                <span class="eyebrow">{g.kicker}</span>
                <p>{g.note}</p>
                <a class="btn btn--primary" href="/marketplace/">Conoce más</a>
              </div>
            </div>
          )}
        </>
      ))}
    </section>

    <!-- ============================== ALCANCE (product wall) ============================== -->
    <!-- Editorial two-column band: copy owns the left with generous air, the
         drifting product tiles live in their own zone on the right — they
         never run behind the text. -->
    <section class="wall">
      <div class="wall__copy">
        <h2 class="wall__title">{alcance.title}</h2>
        <p class="lede">{alcance.desc}</p>
        <a class="link-underline" href="#marketplace">Ver el Marketplace</a>
      </div>

      <!-- Decorative: rows of product tiles drifting sideways. Each row is
           rendered twice and slid by exactly one copy for a seamless loop. -->
      <div class="wall__rails" aria-hidden="true">
        {wallRows.map((row, i) => (
          <div class="wall__rail">
            <div class="wall__track" style={`--dur:${38 + i * 9}s;--dir:${i % 2 ? 'reverse' : 'normal'}`}>
              {[...row, ...row].map((p) => (
                <span class="wall__tile">
                  <img
                    src={`/img/productos/lg/${p}.webp`}
                    alt=""
                    width="128"
                    height="128"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============================== CÓMO EMPEZAR ============================== -->
    <section class="section start" id="como-empezar">
      <div class="start__grid">
        <div class="start__copy">
          <h2 class="eyebrow">¿Cómo empezar?</h2>
          <p class="start__sub">ataskate se configura a como tú trabajas.</p>

          <div class="acc" data-acc>
            {pasos.map((p, i) => (
              <div class="acc__item">
                <h3 class="acc__h">
                  <button
                    type="button"
                    class="acc__btn"
                    aria-expanded={i === 0 ? 'true' : 'false'}
                    aria-controls={`paso-${i}`}
                    id={`paso-btn-${i}`}
                  >
                    <span class="acc__label">
                      <span class="acc__num" aria-hidden="true">{i + 1}</span>
                      {p.title}
                    </span>
                    <span class="acc__sign" aria-hidden="true">{i === 0 ? '–' : '+'}</span>
                  </button>
                </h3>
                <div class="acc__panel" id={`paso-${i}`} role="region" aria-labelledby={`paso-btn-${i}`} hidden={i !== 0}>
                  <p>{p.desc}</p>
                  {p.cta && <a class="link-underline link-underline--sm" href="#cta">Contáctanos</a>}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Product shots on the lila panel — one per step, swapped with a
             spring pop when the visitor opens a step in the accordion. -->
        <div class="start__panel">
          <div class="start__shots" data-shots>
            {pasos.map((p, i) => (
              <img
                class={`start__shot${i === 0 ? ' is-active' : ''}`}
                data-shot={i}
                src={p.shot}
                alt={p.shotAlt}
                width="1400"
                height="910"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================== LA RED ATASKATE (globo) ============================== -->
    <section class="net">
      <div class="net__globe">
        <canvas data-globe aria-hidden="true"></canvas>
        <!-- Live mini-popup that hops between branches. -->
        <div class="net__pop" data-netpop hidden aria-hidden="true">
          <b data-netpop-t></b>
          <span data-netpop-s></span>
        </div>
        <div class="net__chip">
          <span class="net__pulse" aria-hidden="true"></span>
          Casas de empeño conectadas en todo México
        </div>
        <button class="net__zoom" type="button" data-netzoom aria-label="Acercar el mapa" aria-pressed="false">
          <span aria-hidden="true">+</span>
        </button>
      </div>
      <div class="net__copy">
        <h2 class="h2">La red ataskate</h2>
        <p class="lede">Todas tus casas de empeño, conectadas.</p>
        <p class="lede">
          De Tijuana a Mérida: sucursales, bodegas y Marketplace hablando entre sí, en tiempo
          real, sobre una sola red.
        </p>
      </div>
    </section>

    <!-- ============================== PRECIOS ============================== -->
    <section class="section price" id="precios">
      <div class="head head--center">
        <h2 class="eyebrow">Precios</h2>
        <p class="lede price__sub">Empieza hoy con ataskate Ordena.</p>
        <p class="lede">Sin módulos de más, sin cobros sorpresa, sin decidir qué funciones activar.</p>
      </div>

      <div class="plan">
        <div class="plan__head">
          <span class="plan__promo">Promoción de lanzamiento</span>
          <div class="plan__id">
            <b>ataskate Ordena</b>
            <span>
              Empieza a operar con contratos, caja, inventario y clientes desde un solo lugar.
            </span>
          </div>
          <p class="plan__price">
            <b data-price>$99</b>
            <span>
              <b>USD <s>$149</s></b>
              <small>por sucursal / mes</small>
            </span>
          </p>
          <ul class="plan__chips" aria-label="Incluido en tu plan">
            {planIncluido.map((c) => <li>{c}</li>)}
          </ul>
        </div>

        <ul class="plan__list">
          {planTop.map((i) => (
            <li><span class="plan__check"><DsIcon name="ActionCheck" size={12} /></span>{i}</li>
          ))}
        </ul>

        <div class="plan__more">
          <a class="link-underline" href="/planes/">Explora todos los planes</a>
        </div>

        <div class="plan__actions">
          <a class="btn btn--primary btn--lg" href="#cta">Crea tu cuenta</a>
        </div>
      </div>
    </section>

    <!-- ============================== FAQ ============================== -->
    <section class="section faq">
      <div class="head head--center">
        <h2 class="eyebrow">Preguntas frecuentes</h2>
        <p class="lede">¿Aún tienes dudas?</p>
      </div>

      <div class="acc acc--faq" data-acc>
        {faqs.map((f, i) => (
          <div class="acc__item">
            <h3 class="acc__h">
              <button
                type="button"
                class="acc__btn acc__btn--faq"
                aria-expanded={i === 0 ? 'true' : 'false'}
                aria-controls={`faq-${i}`}
                id={`faq-btn-${i}`}
              >
                <span>{f.q}</span>
                <span class="acc__chev" aria-hidden="true"><DsIcon name="NavigationArrowDown" size={20} /></span>
              </button>
            </h3>
            <div class="acc__panel acc__panel--faq" id={`faq-${i}`} role="region" aria-labelledby={`faq-btn-${i}`} hidden={i !== 0}>
              <p>{f.a}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ============================== CTA ============================== -->
    <section class="cta" id="cta">
      <div class="cta__pill cta__pill--a" data-plx="0.15" aria-hidden="true">
        <span class="pill pill--ink" style="animation-delay:-1s">Empeños</span>
      </div>
      <div class="cta__pill cta__pill--b" data-plx="0.2" aria-hidden="true">
        <span class="pill pill--lemon" style="animation-delay:-3.5s">a un clic</span>
      </div>

      <div class="cta__inner">
        <h2 class="cta__title">Empieza hoy con ataskate.</h2>
        <p class="cta__lede">Acceso inmediato. Sin contratos forzosos. Cancela cuando quieras.</p>

        <!-- Formulario de contacto: se envía a ventas por CONTACTO_API. Sin JS,
             el action mailto abre el correo del visitante con los datos. -->
        <form
          class="cta__form"
          data-demo
          action={`mailto:${contacto.email}`}
          method="post"
          enctype="text/plain"
          data-api={CONTACTO_API}
          data-mail={contacto.email}
          novalidate
        >
          <div class="cta__field">
            <label for="cta-nombre">Nombre</label>
            <input id="cta-nombre" name="nombre" type="text" placeholder="Mariana Quintero" autocomplete="name" required />
          </div>
          <div class="cta__field">
            <label for="cta-negocio">Nombre de negocio</label>
            <input id="cta-negocio" name="negocio" type="text" placeholder="Empeños del Centro" autocomplete="organization" required />
          </div>
          <div class="cta__field">
            <label for="cta-rfc">RFC</label>
            <input
              id="cta-rfc"
              name="rfc"
              type="text"
              placeholder="EDC850101AB1"
              autocomplete="off"
              autocapitalize="characters"
              spellcheck="false"
              minlength="12"
              maxlength="13"
              pattern="[A-ZÑ&]{3,4}[0-9]{2}(0[1-9]|1[0-2])(0[1-9]|[12][0-9]|3[01])[A-Z0-9]{2}[A0-9]"
              data-rfc
              required
            />
          </div>
          <div class="cta__field">
            <label for="cta-email">Correo</label>
            <input id="cta-email" name="correo" type="email" placeholder="mariana@empenosdelcentro.mx" autocomplete="email" required />
          </div>
          <div class="cta__field">
            <label for="cta-tel">Teléfono o WhatsApp <span class="cta__opt">(Opcional)</span></label>
            <input id="cta-tel" name="telefono" type="tel" placeholder="55 1234 5678" autocomplete="tel" inputmode="tel" />
          </div>
          <div class="cta__field">
            <label for="cta-suc">Número de sucursales</label>
            <select id="cta-suc" name="sucursales">
              <option value="1">1 sucursal</option>
              <option value="2-5" selected>2 a 5 sucursales</option>
              <option value="6-15">6 a 15 sucursales</option>
              <option value="16+">Más de 15 sucursales</option>
            </select>
          </div>
          <!-- campo trampa para bots: oculto a personas, un bot lo llena y el servidor lo ignora -->
          <div class="cta__hp" aria-hidden="true">
            <label for="cta-web">Sitio web</label>
            <input id="cta-web" name="empresa_web" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <p class="cta__error" data-error role="alert" hidden></p>
          <button class="btn btn--primary cta__submit" type="submit" data-submit>Solicita una demo</button>
          <p class="cta__consent">Al enviar aceptas que te contactemos por correo o WhatsApp para agendar tu demo.</p>
        </form>
        <div class="cta__done" data-done hidden tabindex="-1" role="status">
          <span class="cta__done-ico" aria-hidden="true">✓</span>
          <b>¡Listo, ya tenemos tus datos!</b>
          <span>Un asesor de ventas te escribe en menos de 24 horas hábiles para agendar tu demo.</span>
        </div>

        <p class="cta__note">
          ¿Prefieres hablar con un experto? Escríbenos por <a data-wa href={WHATSAPP} target="_blank" rel="noopener">WhatsApp al {contacto.tel}</a> o a
          <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
        </p>
      </div>
    </section>
  </main>

  <!-- ============================== FOOTER ============================== -->
  <footer class="foot">
    <div class="foot__grid">
      <div class="foot__brand">
        <img src="/brand/ataskate-white.svg" alt="ataskate" width="335" height="62" />
        <p>Software de operación 100% digital para casas de empeño.</p>
      </div>

      <div class="foot__col">
        <b>Producto</b>
        <a href="#funciones">Funciones</a>
        <a href="#marketplace">Marketplace</a>
        <a href="#precios">Precios</a>
        <a href="#como-empezar">Cómo empezar</a>
      </div>

      <div class="foot__col">
        <b>Legal</b>
        <a href="#cta">Aviso de privacidad</a>
        <a href="#cta">Términos y condiciones</a>
      </div>

      <div class="foot__col">
        <b>Contacto</b>
        <a class="foot__wa" data-wa href={WHATSAPP} target="_blank" rel="noopener"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M2 22L3.41254 16.8642C2.5409 15.3608 2.08289 13.6567 2.08373 11.9092C2.08624 6.44583 6.55329 2 12.0419 2C14.7053 2.00083 17.2056 3.03333 19.0862 4.90667C20.9659 6.78 22.0008 9.27 22 11.9183C21.9975 17.3825 17.5304 21.8283 12.0419 21.8283C10.3756 21.8275 8.73365 21.4117 7.27924 20.6217L2 22ZM7.52374 18.8275C8.92707 19.6567 10.2668 20.1533 12.0385 20.1542C16.6002 20.1542 20.3162 16.4592 20.3187 11.9167C20.3204 7.365 16.622 3.675 12.0452 3.67333C7.4802 3.67333 3.76673 7.36833 3.76505 11.91C3.76421 13.7642 4.31014 15.1525 5.22699 16.605L4.39052 19.645L7.52374 18.8275ZM17.0582 14.2742C16.9962 14.1708 16.8304 14.1092 16.5809 13.985C16.3322 13.8608 15.1089 13.2617 14.8803 13.1792C14.6526 13.0967 14.4868 13.055 14.3202 13.3033C14.1544 13.5508 13.6771 14.1092 13.5323 14.2742C13.3874 14.4392 13.2417 14.46 12.993 14.3358C12.7444 14.2117 11.9422 13.9508 10.9919 13.1067C10.2525 12.45 9.75266 11.6392 9.6078 11.3908C9.46295 11.1433 9.59273 11.0092 9.71665 10.8858C9.82885 10.775 9.96533 10.5967 10.0901 10.4517C10.2165 10.3083 10.2576 10.205 10.3413 10.0392C10.4242 9.87417 10.3832 9.72917 10.3204 9.605C10.2576 9.48167 9.76019 8.2625 9.55338 7.76667C9.35075 7.28417 9.14561 7.34917 8.99322 7.34167L8.51595 7.33333C8.35016 7.33333 8.08055 7.395 7.8528 7.64333C7.62505 7.89167 6.982 8.49 6.982 9.70917C6.982 10.9283 7.87373 12.1058 7.99765 12.2708C8.12241 12.4358 9.75182 14.9375 12.2478 16.01C12.8415 16.265 13.3054 16.4175 13.6662 16.5317C14.2624 16.72 14.805 16.6933 15.2337 16.63C15.7118 16.5592 16.7057 16.0308 16.9133 15.4525C17.121 14.8733 17.121 14.3775 17.0582 14.2742Z"/></svg>WhatsApp {contacto.tel}</a>
        <a href={`mailto:${contacto.email}`}>{contacto.email}</a>
        <a href="tel:+525569750198">Teléfono {contacto.tel}</a>
      </div>
    </div>

    <div class="foot__bar">
      <span>© ataskate. Hub de casas de empeño. Todos los derechos reservados.</span>
      <span>
        Hecho en México · Algunas imágenes de producto:
        <a href="https://commons.wikimedia.org" style="color:inherit;text-decoration:underline">Wikimedia Commons</a>
        (PD / CC BY / CC BY-SA)
      </span>
    </div>
  </footer>
</LandingLayout>

<style>
  /* ============================================================
     Shared primitives
     ============================================================ */
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .nowrap { white-space: nowrap; }

  .section {
    max-width: 1180px;
    margin-inline: auto;
    padding: 80px 26px;
  }
  .section--tight { padding-block: 80px 16px; }
  .fx { padding-block: 104px 48px; }

  .head {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 680px;
  }
  .head--center {
    max-width: none;
    align-items: center;
    text-align: center;
  }

  /* Section kickers: sentence case (no all-caps), a step bigger than before. */
  .eyebrow {
    font-family: var(--font-display);
    font-size: clamp(30px, 3.5vw, 48px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: balance;
  }
  /* Section subtitles: Nunito, tight and confident — the serif stays for the
     hero and for accent moments (quotes, prices). */
  .h2 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.16;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: pretty;
  }
  /* Gradient word inside a heading (Google-AI-style sweep). */
  .grad {
    color: var(--indigo); /* fallback without background-clip:text */
    background: linear-gradient(92deg, #5a5aff 0%, #9a5aff 48%, #ff6ae8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lede {
    font-size: 20px;
    line-height: 1.5;
    color: var(--caption);
    text-wrap: pretty;
    max-width: 60ch;
  }
  /* El titulo de la red va en la serif display, no en Nunito */
  .net__copy .h2 {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0;
  }

  .link-underline {
    align-self: flex-start;
    font-size: 16px;
    font-weight: 800;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    padding-bottom: 2px;
    transition: color 0.12s, border-color 0.12s;
  }
  .link-underline--sm { font-size: 14px; }
  .link-underline:hover { color: var(--indigo); border-bottom-color: var(--indigo); }

  /* ---------- buttons — ataskate design system (.ds-btn) ----------
     Values transcribed from design-system/src/components/components.css:
     pill, Nunito Bold 14/20, 1px border box, 150ms standard easing,
     active = translateY(1px), focus = 3px rgba(90,90,255,.4) ring.
     Sizes: md 8/16 · lg 12/24 · xl 16/32. */
  /* ---------- floating brand pills ---------- */
  .pill {
    display: inline-flex;
    align-items: center;
    padding: 6px 16px;
    border-radius: 100px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    white-space: nowrap;
    box-shadow: 0 2px 10px rgba(13, 22, 107, 0.1);
    pointer-events: none;
    animation: pillDrift 7s ease-in-out infinite;
  }
  .pill--ink { background: #fff; color: var(--navy); }
  .pill--lemon { background: var(--lemon-200); color: var(--ink); }
  .pill--pink { background: var(--pink-200); color: var(--ink); }
  .pill--pink-soft { background: var(--pink-100); color: var(--ink); }
  .pill--offset { margin-left: 26px; }

  /* ---------- text micro-reveals (Apple-style) ----------
     JS tags copy blocks with .tfx; they fade up gently when they enter the
     viewport and re-arm when they fully leave. --fd staggers a batch. */
  .tfx {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.65s ease,
      transform 0.65s cubic-bezier(0.22, 0.61, 0.36, 1);
    transition-delay: var(--fd, 0s);
  }
  .tfx.tfx-in {
    opacity: 1;
    transform: none;
  }

  @keyframes pillDrift {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50% { transform: translateY(-12px) rotate(2deg); }
  }
  @keyframes floaty {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-14px); }
  }

  /* ============================================================
     Header
     ============================================================ */
  .mast__burger {
    display: none;
    flex: 0 0 auto;
    width: 40px;
    height: 40px;
    margin-left: auto;
    border-radius: 100px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 4px;
  }
  .mast__burger span {
    display: block;
    width: 18px;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.18s, opacity 0.18s;
  }
  .mast__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .mast__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .mast__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  /* ============================================================
     Hero
     ============================================================ */
  .hero {
    position: relative;
    margin: 12px 12px 0;
    border-radius: 24px;
    overflow: hidden;
    background: var(--ink);
    min-height: clamp(560px, 78vh, 760px);
    display: flex;
    align-items: center;
  }
  .hero__bg,
  .hero__bg video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__bg video { object-fit: cover; }
  /* Left scrim so the copy reads over the footage, Shopify-style. */
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    display: block;
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        97deg,
        rgba(11, 14, 55, 0.88) 0%,
        rgba(11, 14, 55, 0.62) 34%,
        rgba(11, 14, 55, 0.22) 58%,
        rgba(13, 15, 26, 0) 76%
      ),
      linear-gradient(180deg, rgba(13, 15, 26, 0) 68%, rgba(13, 15, 26, 0.35) 100%);
  }
  .hero__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 22px;
    align-items: flex-start;
    max-width: 660px;
    padding: clamp(48px, 7vw, 96px) clamp(24px, 3vw, 48px) clamp(48px, 7vw, 96px)
      clamp(28px, 5vw, 76px);
  }
  .hero__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #fff;
    text-wrap: balance;
  }
  /* The lemon highlight around "control": an inline-block with its own line
     box so the word sits optically centered in the pill. */
  .hero__title em {
    font-style: normal;
    display: inline-block;
    line-height: 1.06;
    padding: 0 0.3em 0.118em;
    background: var(--lemon-200);
    border-radius: 100px;
    vertical-align: baseline;
    color: var(--ink);
  }
  .hero__lede {
    font-size: clamp(17px, 1.45vw, 20px);
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.92);
    max-width: none;
    text-wrap: pretty;
  }
  .hero__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }

  /* Trust pills floating over the right side of the footage. */
  .hero__chips { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .hero__chips li {
    position: absolute;
    top: var(--t);
    left: var(--l, auto);
    right: var(--r, auto);
    display: inline-flex;
    align-items: center;
    padding: 7px 15px;
    border-radius: 100px;
    background: var(--bg, #fff);
    box-shadow: 0 4px 16px rgba(13, 22, 107, 0.28);
    font-family: var(--font-display);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.25;
    color: var(--fg, var(--ink));
    white-space: nowrap;
    animation: pillDrift 8s ease-in-out infinite;
    animation-delay: var(--d, 0s);
  }

  /* ---------- hero video + scroll flight ---------- */
  /* The slot holds the layout box; the .vid inside is what travels. */
  .vidslot {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .vid {
    position: absolute;
    inset: 0;
    /* Docked in the hero: square on the left (it butts against the copy) and
       24px on the right to follow the hero's own corners. JS interpolates all
       four corners to `16px 16px 0 0` as it seats into the POS card — the
       lifted element is fixed, so the hero's overflow cannot round it. */
    border-radius: 0 24px 24px 0;
    overflow: hidden;
    background: var(--ink);
  }
  .vid__el { width: 100%; height: 100%; object-fit: cover; }

  /* Flying state: JS lifts the element to <body> and drives translate + an
     explicit width/height between the two slots. Sizing the box (rather than
     scaling it) lets the landing rect have its own aspect ratio — object-fit
     on the video absorbs the difference — and keeps the radius honest. */
  .vid.is-flying {
    position: fixed;
    inset: auto;
    left: 0;
    top: 0;
    /* Above every unpositioned section it flies over, but below .hero__grid
       (2) so the hero chips stay on top, and below the header (50). */
    z-index: 1;
    pointer-events: none;
    will-change: transform, width, height;
  }

  /* Full-bleed landing box: the whole media area of the POS card. */
  .fx__drop {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  /* ============================================================
     Funciones
     ============================================================ */
  /* Only holds the rail arrows now; collapses entirely when they're hidden. */
  .fx__bar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 16px;
    margin-top: 24px;
  }
  .fx__bar:has(.fx__nav[hidden]) { display: none; }
  .fx__nav { display: flex; gap: 10px; }
  .fx__nav[hidden] { display: none; }
  .rail-btn {
    width: 44px;
    height: 44px;
    border-radius: 100px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: inset 0 0 0 1.5px var(--line);
    color: var(--placeholder);
    transition: background-color 0.12s, color 0.12s, box-shadow 0.12s;
  }
  .rail-btn--on { box-shadow: inset 0 0 0 1.5px var(--ink); color: var(--ink); }
  .rail-btn:hover:not(:disabled) { background: var(--purple-50); color: var(--navy); }
  .rail-btn:disabled { cursor: default; box-shadow: inset 0 0 0 1.5px var(--line); color: var(--placeholder); }

  /* Hover-expanding rail with STATIC media: every card always shows its image
     (no icons, no playing card-videos). Hovering a card only hands it the
     wide grid track and the lila background; the pictures never move. */
  .fx__rail {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 16px;
    margin-top: 24px;
    align-items: stretch;
    transition: grid-template-columns 0.55s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  @media (min-width: 981px) {
    .fx__rail[data-exp='1'] { grid-template-columns: 1fr 1.5fr 1fr; }
    .fx__rail[data-exp='2'] { grid-template-columns: 1fr 1fr 1.5fr; }
  }

  .fx__card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 480px;
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: background-color 0.45s ease;
  }
  /* The lead ships with is-exp in the markup, so it is lila everywhere the
     hover stage is off (mobile rail, no-JS) and hands it over on hover. */
  .fx__card.is-exp { background: var(--lila-200); }

  .fx__stage {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    min-height: 300px;
    border-radius: 16px 16px 0 0;
    overflow: hidden;
    background: var(--purple-10);
  }
  /* The lead card's media area carries the poster still; the flying hero
     video sits on top of it. */
  .fx__card--lead .fx__stage {
    background: var(--lila-200) url('/video/landing-pos-poster.jpg') center / cover no-repeat;
  }

  .fx__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .fx__pills {
    position: absolute;
    top: 28px;
    right: 28px;
    /* Above the landed video (a body-level fixed element at z-index 1). */
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .fx__pills .pill--offset { margin-left: 22px; }

  .fx__body {
    padding: 22px 28px 26px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fx__name {
    align-self: flex-start;
    font-size: 17px;
    font-weight: 800;
    color: var(--ink);
    border-bottom: 2px solid var(--ink);
    padding-bottom: 3px;
  }
  .fx__name--lg { font-size: 19px; }
  .fx__meta { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
  .fx__meta p { font-size: 14px; line-height: 1.5; color: var(--body); max-width: 300px; }
  /* The tag line ("Flujo de efectivo" …) only shows on the expanded card. */
  .fx__tag {
    font-size: 14px;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
    transition: opacity 0.25s ease;
  }
  .fx__card:not(.is-exp) .fx__tag { opacity: 0; }
  .fx__desc { font-size: 14px; line-height: 1.5; color: var(--caption); }

  /* ============================================================
     Suite — bento bajo el hero
     ============================================================ */
  .suite {
    position: relative;
    max-width: 1180px;
    margin-inline: auto;
    padding: clamp(56px, 6vw, 84px) 26px 0;
  }
  .suite > * { position: relative; z-index: 1; }
  /* The intro heading sits in its own glass box — anchored, not floating. */
  /* Revolut-style opener: oversized centered title, one-line sub, a single
     CTA, and three portrait photo cards with the operation's numbers on top. */
  .intro { padding: clamp(8px, 1.5vw, 20px) 0 clamp(40px, 5vw, 72px); }
  .suite .intro__head { margin-inline: auto; max-width: 1000px; padding: 0; gap: 0; }
  .intro__title {
    font-size: clamp(36px, 4.8vw, 68px);
    line-height: 1.04;
    letter-spacing: -0.022em;
    max-width: 1000px;
  }
  .intro__sub {
    margin-top: clamp(14px, 1.6vw, 22px);
    font-size: clamp(18px, 1.55vw, 23px);
    max-width: 700px;
  }
  .intro__cta { margin-top: clamp(24px, 2.6vw, 36px); }
  .intro__cards {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(16px, 2.2vw, 30px);
    margin-top: clamp(44px, 5.5vw, 76px);
  }
  .icard {
    position: relative;
    margin: 0;
    flex: none;
    width: clamp(232px, 25.5vw, 362px);
    aspect-ratio: 362 / 512;
    border-radius: 28px;
    overflow: hidden;
    background: var(--purple-50);
    box-shadow: 0 26px 60px rgba(13, 22, 107, 0.16);
    transition: transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.55s ease;
  }
  .icard--1 { width: clamp(258px, 28.2vw, 400px); }
  .icard:hover { transform: translateY(-8px); box-shadow: 0 34px 70px rgba(13, 22, 107, 0.2); }
  .icard img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 760px) {
    .intro__cards {
      justify-content: flex-start;
      align-items: stretch;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: -26px;
      padding: 8px 26px 28px;
    }
    .intro__cards::-webkit-scrollbar { display: none; }
    .icard, .icard--1 { width: min(78vw, 340px); scroll-snap-align: center; }
  }

  .suite__kicker {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: clamp(30px, 3.5vw, 44px) 0 16px;
  }
  /* Marketplace reads as its own section: generous gap and a hairline. */
  /* The illustration opens the Marketplace block edge to edge, flush against
     the POS wash above (no gap, no hairline); the copy sits centered below. */
  .mkt-hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(44px, 5vw, 72px);
    margin-top: 0;
    /* Generous air below the CTA so the block breathes before the wall. */
    padding: 0 0 80px;
  }
  .mkt-hero .suite__kicker { margin: 0; gap: 10px; }
  .mkt-hero .suite__kicker .btn { margin-top: 14px; } /* 10px gap + 14 = 24px under the lede, same as the POS kicker */
  .mkt-hero__art {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    border-radius: 0;
    overflow: hidden;
  }
  .mkt-hero__art img { width: 100%; height: auto; display: block; }
  .suite__kicker p {
    font-size: 20px;
    line-height: 1.5;
    color: var(--caption);
    text-wrap: pretty;
    max-width: 60ch;
  }

  /* Highlights carousel: big snap cards, image first, copy below. Glass with
     a whisper of pink over the ambient blobs; manual navigation only. */
  .hl { position: relative; }
  /* The track bleeds to the viewport edges so cards clip at the screen, not
     at an arbitrary inner line — the previous card peeks in from the left,
     Apple-style. scroll-padding keeps snap aligned to the content column. */
  .hl__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    margin-inline: calc(50% - 50vw);
    padding: 4px max(26px, calc(50vw - 50%));
    scroll-padding-inline: max(26px, calc(50vw - 50%));
  }
  .hl__track::-webkit-scrollbar { display: none; }

  .hl__card {
    flex: 0 0 min(520px, 86%);
    scroll-snap-align: center;
    display: flex;
    flex-direction: column;
    border-radius: 20px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(255, 198, 246, 0.16), rgba(255, 255, 255, 0.05) 45%),
      rgba(255, 255, 255, 0.55);
    -webkit-backdrop-filter: blur(18px) saturate(1.5);
    backdrop-filter: blur(18px) saturate(1.5);
    border: 1px solid rgba(255, 255, 255, 0.75);
    box-shadow:
      0 8px 28px rgba(13, 22, 107, 0.07),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  .hl__media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f0f1f3;
  }
  .hl__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }
  /* Product cut-outs float on the grey panel instead of covering it. */
  .hl__media--product img {
    object-fit: contain;
    object-position: center;
    padding: 9%;
    mix-blend-mode: multiply;
  }
  .hl__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 26px 26px;
  }

  /* Feature card: copy left, animated client UI right — a bit wider. */
  .hl__card--feature {
    flex: 0 0 min(720px, 92%);
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
  }
  .hl__body--side { padding: 28px 8px 28px 28px; }

  /* ============================================================
     La red ataskate — globo
     ============================================================ */
  .net {
    margin: 0 12px;
    border-radius: 24px;
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-card);
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(16px, 2.5vw, 40px);
    padding: clamp(48px, 5vw, 72px) clamp(28px, 4.5vw, 56px);
  }
  /* The planet is a free dome rising from the card's bottom edge — no square
     frame around it: the canvas bleeds into the band's padding and the .net
     overflow crops it exactly at the card border. */
  .net__globe {
    position: relative;
    aspect-ratio: 10 / 9;
    max-width: 780px;
    width: 100%;
    align-self: end;
    /* Bleed into the card's own padding: flush against the left edge and the
       bottom border — no dead white margin around the planet. */
    margin-left: calc(-1 * clamp(28px, 4.5vw, 56px));
    margin-bottom: calc(-1 * clamp(48px, 5vw, 72px));
  }
  /* Live branch popup: follows its city dot on the canvas. */
  .net__pop {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(-50%, -118%) scale(0.85);
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 9px 13px;
    border-radius: 11px;
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 10px 26px rgba(13, 22, 107, 0.16);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.32s ease, transform 0.42s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    white-space: nowrap;
  }
  .net__pop.is-on { opacity: 1; transform: translate(-50%, -128%) scale(1); }
  .net__pop::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -5px;
    width: 10px;
    height: 10px;
    transform: translateX(-50%) rotate(45deg);
    background: rgba(255, 255, 255, 0.82);
    border-right: 1px solid rgba(255, 255, 255, 0.85);
    border-bottom: 1px solid rgba(255, 255, 255, 0.85);
  }
  .net__pop b { font-size: 12.5px; font-weight: 800; color: var(--navy); line-height: 1.3; }
  .net__pop span { font-size: 11.5px; color: var(--caption); line-height: 1.3; }
  .net__pop[hidden] { display: none; }
  .net__globe canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .net__chip {
    position: absolute;
    left: 4%;
    bottom: 9%;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 10px 16px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.7);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
    backdrop-filter: blur(14px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.8);
    box-shadow: 0 8px 24px rgba(13, 22, 107, 0.12);
    font-size: 13px;
    font-weight: 700;
    color: var(--navy);
    max-width: 78%;
    line-height: 1.35;
  }
  .net__zoom {
    position: absolute;
    right: 5%;
    bottom: 9%;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    border: 1px solid rgba(255, 255, 255, 0.85);
    box-shadow: 0 8px 24px rgba(13, 22, 107, 0.16);
    color: var(--navy);
    font-size: 26px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .net__zoom:hover { background: #fff; transform: scale(1.06); }
  .net__zoom[aria-pressed='true'] span { display: inline-block; transform: translateY(-2px); }

  .net__pulse {
    flex: 0 0 auto;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--indigo);
    box-shadow: 0 0 0 0 rgba(90, 90, 255, 0.45);
    animation: netPulse 2.2s ease-out infinite;
  }
  @keyframes netPulse {
    from { box-shadow: 0 0 0 0 rgba(90, 90, 255, 0.45); }
    to { box-shadow: 0 0 0 12px rgba(90, 90, 255, 0); }
  }
  .net__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    max-width: 460px;
  }

  /* ============================================================
     Alcance — product wall (editorial two-column band)
     ============================================================ */
  .wall {
    margin: 0 12px;
    border-radius: 24px;
    overflow: hidden;
    background: #fff;
    box-shadow: var(--shadow-card);
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(24px, 3vw, 48px);
    padding: clamp(64px, 7vw, 104px) clamp(28px, 4.5vw, 56px);
    /* Left edge aligns with the 1180px content column of the neighbouring
       sections: the percentage resolves against <main>, not the grid area. */
    padding-left: max(clamp(28px, 4.5vw, 56px), calc((100% - 1128px) / 2 - 12px));
  }

  .wall__copy {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    max-width: 460px;
  }
  .wall__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(26px, 3vw, 38px);
    line-height: 1.16;
    letter-spacing: -0.015em;
    color: var(--ink);
    text-wrap: pretty;
  }

  /* The tiles own the right column — they never run behind the copy. */
  .wall__rails {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    min-width: 0;
    /* Soft edges on both sides so the rows never cut off hard. */
    mask-image: linear-gradient(90deg, transparent 0, #000 9%, #000 91%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 9%, #000 91%, transparent 100%);
  }
  .wall__rail { overflow: hidden; }
  .wall__track {
    display: flex;
    gap: 14px;
    width: max-content;
    animation: wallSlide var(--dur, 40s) linear infinite;
    animation-direction: var(--dir, normal);
  }
  /* One copy plus one gap — the extra 7px cancels the half gap that a plain
     -50% would leave behind, which is what makes the seam invisible. */
  @keyframes wallSlide {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(calc(-50% - 7px), 0, 0); }
  }

  .wall__tile {
    flex: 0 0 auto;
    width: 76px;
    height: 76px;
    border-radius: 19px;
    /* The marketplace's product-thumb surface. */
    background: #f0f1f3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  /* multiply drops any residual white fringe from the cut-outs onto the grey,
     the same trick the marketplace thumbs use. */
  .wall__tile img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14%;
    mix-blend-mode: multiply;
  }

  /* ============================================================
     Beneficios
     ============================================================ */
  .ben__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 48px;
  }
  /* Benefit cards — photo (or icon stage) on top, copy below, same card
     grammar as the POS feature card: top-rounded media, text underneath. */
  .ben__card {
    display: flex;
    flex-direction: column;
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }
  .ben__media {
    width: 100%;
    height: auto; /* beat the width/height attribute pair */
    aspect-ratio: 1100 / 738;
    object-fit: cover;
    display: block;
  }
  .ben__media--stage {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--purple-10);
    box-shadow: inset 0 -1px 0 var(--line-soft);
  }
  .ben__ico {
    width: 96px;
    height: 96px;
    border-radius: 24px;
    background: var(--purple-50);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--indigo);
  }
  .ben__body { display: flex; flex-direction: column; gap: 8px; padding: 20px 24px 24px; }
  .ben__title { font-size: 18px; font-weight: 800; color: var(--ink); }
  .ben__desc { font-size: 14px; line-height: 1.5; color: var(--caption); }

  /* ============================================================
     Dolores
     ============================================================ */
  .pain {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
  }
  .pain__card {
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .pain__quote {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.3;
    color: var(--ink);
    text-wrap: pretty;
  }
  .pain__fix {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--body);
  }
  .pain__ico { color: var(--ok-icon); flex: 0 0 auto; margin-top: 1px; }

  /* ============================================================
     Cómo empezar
     ============================================================ */
  .start__grid {
    display: grid;
    /* The screenshot panel takes the clearly larger share. */
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(28px, 3.2vw, 52px);
    align-items: center;
  }
  .start__copy { display: flex; flex-direction: column; gap: 18px; align-items: flex-start; }
  .start__sub {
    font-size: 20px;
    line-height: 1.5;
    color: var(--caption);
    text-wrap: pretty;
    max-width: 60ch;
    margin: -14px 0 0; /* tuck under the kicker, tighter than the flex gap */
  }

  .acc { display: flex; flex-direction: column; width: 100%; margin-top: 12px; }
  .acc__item { border-bottom: 1px solid var(--line-soft); }
  .acc__h { font: inherit; margin: 0; }
  .acc__btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
    text-align: left;
    font-size: 18px;
    font-weight: 800;
    letter-spacing: 0.3px;
    color: var(--ink);
  }
  .acc__btn--faq { padding: 18px 4px; }
  .acc__label { display: flex; align-items: baseline; gap: 14px; min-width: 0; }
  /* Step numeral — the display serif (Platypi), same as the headings. */
  .acc__num {
    flex: 0 0 auto;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 24px;
    line-height: 1;
    color: var(--indigo);
    min-width: 20px;
  }
  .acc__sign { flex: 0 0 auto; font-weight: 400; font-size: 26px; line-height: 1; color: var(--ink); }
  .acc__chev { flex: 0 0 auto; color: var(--indigo); transition: transform 0.2s; }
  .acc__btn[aria-expanded='true'] .acc__chev { transform: rotate(180deg); }

  .acc__panel {
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-start;
    padding: 0 0 22px;
  }
  .acc__panel p { font-size: 16px; line-height: 1.6; color: var(--body); max-width: 460px; }
  .acc__panel--faq { padding: 0 4px 18px; }
  .acc__panel--faq p { font-size: 16px; line-height: 1.55; color: var(--caption); max-width: none; }
  .acc__panel[hidden] { display: none; }

  .start__panel {
    border-radius: 24px;
    background: var(--lila-200);
    /* Tight frame: the screenshot carries the panel, the lila is just a mat. */
    padding: clamp(14px, 1.6vw, 22px);
    display: flex;
    align-items: center;
    justify-content: center;
    align-self: center;
  }

  /* ---------- step screenshots (swap on accordion click) ----------
     The images are stacked; the active one springs up into place while the
     outgoing one lifts away with a touch of blur — a depth swap. */
  .start__shots {
    position: relative;
    width: 100%;
    aspect-ratio: 1400 / 910;
  }
  .start__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    border-radius: 16px;
    box-shadow: var(--shadow-float);
    opacity: 0;
    pointer-events: none;
  }
  .start__shot.is-active {
    opacity: 1;
    animation: shotIn 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) backwards;
  }
  .start__shot.is-leaving {
    animation: shotOut 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes shotIn {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.92);
      filter: blur(8px);
    }
    60% { filter: blur(0); }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }
  @keyframes shotOut {
    from {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
    to {
      opacity: 0;
      transform: translateY(-22px) scale(1.05);
      filter: blur(6px);
    }
  }

  /* ============================================================
     A tu medida — roles + tamaño
     ============================================================ */
  .fit { padding-top: 0; }
  .fit__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 32px;
  }
  .fit__card {
    border-radius: 16px;
    background: #fff;
    box-shadow: var(--shadow-card);
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fit__ico {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    background: var(--purple-50);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--indigo);
    margin-bottom: 4px;
  }
  .fit__title { font-size: 18px; font-weight: 800; color: var(--ink); }
  .fit__desc { font-size: 14px; line-height: 1.5; color: var(--caption); }

  /* ============================================================
     Marketplace
     ============================================================ */
  .mkt__pill { position: absolute; z-index: 1; }
  .mkt__pill--a { top: 52px; right: 8%; }
  .mkt__pill--b { bottom: 36px; left: 36%; }
  .mkt__pill .pill { font-size: 15px; padding: 8px 20px; }

  .mkt__grid {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin-inline: auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .mkt__copy { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .mkt__list { display: flex; flex-direction: column; gap: 10px; }
  .mkt__list li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: #fff;
  }
  .mkt__check { color: var(--lemon-200); flex: 0 0 auto; margin-top: 4px; }

  .mkt__cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  /* Listing card, 1:1 with the real marketplace inventory cards: media area
     flush to the card edges (no padding above or beside the image), Nunito
     text block below. */
  .mkt__card {
    border-radius: 16px;
    background: #fff;
    padding: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  /* Values transcribed 1:1 from the Figma listing-card component (Dev Mode):
     media #f7f7f7 · badge #FFC6F6 / #610052, Nunito SemiBold 12/16 +0.5,
     4px radius, 2/8 padding, at 10,11 · chip +6 white, 1px #D4D6D8 border ·
     name Nunito Regular 14/20 +0.25 #1D1E20 · price Nunito SemiBold 18/24
     #2A2C2F · was-price Regular 14/20 +0.25 #A1A5AA strikethrough. */
  .mkt__thumb {
    position: relative;
    aspect-ratio: 224 / 222;
    background: #f7f7f7;
    display: flex;
